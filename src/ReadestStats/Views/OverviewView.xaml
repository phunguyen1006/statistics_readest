<UserControl x:Class="ReadestStats.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:ReadestStats.Controls" AutomationProperties.Name="Overview page">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="26,22,26,28"><StackPanel MaxWidth="1480">
    <Border Style="{StaticResource EditorialSection}" Visibility="{Binding NoPeriodData,Converter={StaticResource BoolVis}}" Margin="0,0,0,16"><StackPanel Margin="10" HorizontalAlignment="Center"><TextBlock Text="No reading activity in this period" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Read in Readest and refresh to see statistics here." Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border>
    <UniformGrid Columns="6" Margin="0,0,0,16">
      <charts:StatCard Label="TOTAL READING" Value="{Binding Period.TotalSeconds,Converter={StaticResource Duration}}" Detail="{Binding ComparisonText}" Command="{Binding NavigateCommand}" CommandParameter="Activity" Help="Open the activity calendar and reading trend."/>
      <charts:StatCard Label="ACTIVE DAYS" Value="{Binding Period.ActiveDays}" Detail="{Binding Period.ConsistencyPercent,StringFormat={}{0:0}% consistency}" Command="{Binding NavigateCommand}" CommandParameter="Activity" Help="Open the activity calendar. An active day contains at least one valid reading event."/>
      <charts:StatCard Label="CURRENT STREAK" Value="{Binding CurrentStreakLabel}" Detail="{Binding LongestStreakLabel}" Command="{Binding NavigateCommand}" CommandParameter="Goals" Help="Open goals, progress, and previous-year results."/>
      <charts:StatCard Label="AVG / ACTIVE DAY" Value="{Binding Period.AveragePerActiveDay,Converter={StaticResource Duration}}" Detail="Selected period" Command="{Binding NavigateCommand}" CommandParameter="Statistics" Help="Open the complete statistics dashboard."/>
      <charts:StatCard Label="SESSIONS" Value="{Binding Period.SessionCount}" Detail="{Binding Period.AverageSessionSeconds,Converter={StaticResource Duration},StringFormat=Avg {0}}" Command="{Binding NavigateCommand}" CommandParameter="Sessions" Help="Open reconstructed continuous reading sessions."/>
      <charts:StatCard Label="BOOKS ACTIVE" Value="{Binding Period.ActiveBooks}" Detail="{Binding TopBookLabel}" Command="{Binding NavigateCommand}" CommandParameter="Books" Help="Open books with reading activity in the selected period."/>
    </UniformGrid>
    <TextBlock Text="{Binding StreakContinuation}" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,12"/>
    <Border Style="{StaticResource EditorialSection}" Margin="0,0,0,16" Visibility="{Binding HasContinueReading,Converter={StaticResource BoolVis}}"><StackPanel><TextBlock Text="CONTINUE READING" Style="{StaticResource Eyebrow}"/><TextBlock Text="Books in progress, with plans that need attention first" Style="{StaticResource Muted}" Margin="0,3,0,10"/><ItemsControl ItemsSource="{Binding ContinueReading}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.OpenFocusBookCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="12" Margin="0,0,10,0" AutomationProperties.Name="{Binding Title}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="34" Height="48" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1"><Image Source="{Binding CoverPath,Converter={StaticResource CoverImage},ConverterParameter=80}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0"><DockPanel><TextBlock Text="{Binding Plan.Status}" DockPanel.Dock="Right" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" Margin="0,3,0,0"/><TextBlock Text="{Binding Plan.Summary}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="2.15*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource EditorialSection}" Margin="0,0,8,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Reading trend" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding TrendSummary}" Style="{StaticResource Muted}" Margin="0,-8,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><ComboBox ItemsSource="{Binding TrendMetrics}" SelectedItem="{Binding TrendMetric}" Width="128" Margin="0,0,8,0" AutomationProperties.Name="Trend metric"/><ComboBox ItemsSource="{Binding Granularities}" SelectedItem="{Binding TrendGranularity}" Width="88" AutomationProperties.Name="Trend time grouping"/></StackPanel></Grid><charts:LineChart ItemsSource="{Binding Trend}" Height="206" Margin="0,12,0,0" AutomationProperties.Name="Selected-period reading trend" AutomationProperties.HelpText="Use left and right arrow keys to inspect exact points."/><Expander Header="View trend data" Margin="0,4,0,0"><ItemsControl ItemsSource="{Binding Trend}" Margin="0,7,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Detail}" DockPanel.Dock="Right" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Label}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></StackPanel></Border>
      <StackPanel Grid.Column="1" Margin="8,0,0,0"><Border Style="{StaticResource EditorialSection}" Margin="0,0,0,12"><StackPanel><TextBlock Text="PERIOD COMPARISON" Style="{StaticResource Eyebrow}"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="THIS PERIOD" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Comparison.CurrentValue,Converter={StaticResource Duration}}" FontSize="20" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="PREVIOUS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Comparison.PreviousValue,Converter={StaticResource Duration}}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Grid><Separator Background="{DynamicResource Border}" Margin="0,12"/><TextBlock Text="{Binding ComparisonText}"/><TextBlock Text="{Binding AbsoluteDeltaText}" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></Border><Border Style="{StaticResource EditorialSection}"><StackPanel><TextBlock Text="READING PATTERNS" Style="{StaticResource Eyebrow}"/><ItemsControl ItemsSource="{Binding QuickInsights}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.OpenInsightCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource TextLinkButton}" HorizontalContentAlignment="Stretch" Padding="8" Margin="-8,6,-8,0" AutomationProperties.Name="{Binding Title}"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel>
    </Grid>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource EditorialSection}" Margin="0,0,8,0"><StackPanel><TextBlock Text="READING SOURCE MIX" Style="{StaticResource Eyebrow}"/><TextBlock Text="Readest and physical-book time in the selected period" Style="{StaticResource Muted}" Margin="0,3,0,5"/><charts:SegmentedBandChart ItemsSource="{Binding SourceComposition}" Height="76" AutomationProperties.Name="Reading time by source"/><TextBlock Text="{Binding SourceCompositionSummary}" Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource EditorialSection}" Margin="8,0,0,0" Visibility="{Binding HasPhysicalPageProgress,Converter={StaticResource BoolVis}}"><StackPanel><TextBlock Text="PHYSICAL BOOK PROGRESS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Last page reached after each logged session" Style="{StaticResource Muted}" Margin="0,3,0,5"/><charts:LineChart ItemsSource="{Binding PhysicalPageProgress}" Height="92" AutomationProperties.Name="Physical book page progress"/><Expander Header="View exact page data"><ItemsControl ItemsSource="{Binding PhysicalPageProgress}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><TextBlock Text="{Binding Detail}" DockPanel.Dock="Right" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Label}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></StackPanel></Border>
    </Grid>
    <Border Style="{StaticResource EditorialSection}" Margin="0,0,0,16"><StackPanel><DockPanel><TextBlock Text="{Binding Story.StreakContext}" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Reading fingerprint" Style="{StaticResource SectionTitle}"/><TextBlock Text="One mark per day · height and darkness show active reading" Style="{StaticResource Muted}" Margin="0,-7,0,0"/></StackPanel></DockPanel><charts:FingerprintChart ItemsSource="{Binding ReadingFingerprint}" Height="82" Margin="0,8,0,0" AutomationProperties.Name="90-day reading fingerprint" AutomationProperties.HelpText="A compact daily barcode where taller darker marks mean more active reading time."/><charts:StreakStripChart ItemsSource="{Binding StreakTimeline}" Height="48" Margin="32,0,8,0" AutomationProperties.Name="Last 30 days reading streak"/></StackPanel></Border>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource EditorialSection}" Margin="0,0,8,0"><StackPanel><DockPanel><TextBlock Text="Time of day" Style="{StaticResource SectionTitle}"/><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding PatternMetrics}" SelectedItem="{Binding PatternMetric}" Width="92" AutomationProperties.Name="Time pattern metric"/></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions><charts:RadialClockChart ItemsSource="{Binding Hourly}" Height="190" Width="190" AutomationProperties.Name="24-hour reading clock"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="PEAK WINDOW" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding PatternWindowLabel}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,3"/><TextBlock Text="{Binding PatternSummary}" Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Grid></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource EditorialSection}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Day of week" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding PatternWeekdaySummary}" Style="{StaticResource Muted}" Margin="0,-6,0,2"/><charts:BarChart ItemsSource="{Binding Weekdays}" Height="178" MaxBarWidth="24"/></StackPanel></Border></Grid>
    <TextBlock Text="Personal records" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding Records}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource EditorialSection}" Margin="0,0,12,12"><StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,2"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Grid></ScrollViewer>
</UserControl>
