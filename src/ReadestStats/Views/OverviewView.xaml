<UserControl x:Class="ReadestStats.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:ReadestStats.Controls" AutomationProperties.Name="Overview page">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="26,22,26,28"><StackPanel MaxWidth="1480">
    <Border Style="{StaticResource Card}" Visibility="{Binding NoPeriodData,Converter={StaticResource BoolVis}}" Margin="0,0,0,16"><StackPanel Margin="10" HorizontalAlignment="Center"><TextBlock Text="No reading activity in this period" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Read in Readest and refresh to see statistics here." Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border>
    <UniformGrid Columns="6" Margin="0,0,0,16">
      <charts:StatCard Label="TOTAL READING" Value="{Binding Period.TotalSeconds,Converter={StaticResource Duration}}" Detail="{Binding ComparisonText}"/>
      <charts:StatCard Label="ACTIVE DAYS" Value="{Binding Period.ActiveDays}" Detail="{Binding Period.ConsistencyPercent,StringFormat={}{0:0}% consistency}" Help="A day containing at least one valid reading activity."/>
      <charts:StatCard Label="CURRENT STREAK" Value="{Binding CurrentStreakLabel}" Detail="{Binding LongestStreakLabel}"/>
      <charts:StatCard Label="AVG / ACTIVE DAY" Value="{Binding Period.AveragePerActiveDay,Converter={StaticResource Duration}}" Detail="Selected period"/>
      <charts:StatCard Label="SESSIONS" Value="{Binding Period.SessionCount}" Detail="{Binding Period.AverageSessionSeconds,Converter={StaticResource Duration},StringFormat=Avg {0}}" Help="A continuous reading period based on recorded Readest activity."/>
      <charts:StatCard Label="BOOKS ACTIVE" Value="{Binding Period.ActiveBooks}" Detail="{Binding TopBookLabel}" Help="Unique books with reading activity in the selected period."/>
    </UniformGrid>
    <TextBlock Text="{Binding StreakContinuation}" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,12"/>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="2.15*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource ChartCard}" Margin="0,0,8,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Reading trend" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding TrendSummary}" Style="{StaticResource Muted}" Margin="0,-8,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><ComboBox ItemsSource="{Binding TrendMetrics}" SelectedItem="{Binding TrendMetric}" Width="128" Margin="0,0,8,0"/><ComboBox ItemsSource="{Binding Granularities}" SelectedItem="{Binding TrendGranularity}" Width="88"/></StackPanel></Grid><charts:BarChart ItemsSource="{Binding Trend}" Height="226" MaxBarWidth="16" Margin="0,12,0,0"/></StackPanel></Border>
      <StackPanel Grid.Column="1" Margin="8,0,0,0"><Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="PERIOD COMPARISON" Style="{StaticResource Eyebrow}"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="THIS PERIOD" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Comparison.CurrentValue,Converter={StaticResource Duration}}" FontSize="20" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="PREVIOUS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Comparison.PreviousValue,Converter={StaticResource Duration}}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Grid><Separator Background="{DynamicResource Border}" Margin="0,12"/><TextBlock Text="{Binding ComparisonText}"/><TextBlock Text="{Binding AbsoluteDeltaText}" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="QUICK INSIGHTS" Style="{StaticResource Eyebrow}"/><ItemsControl ItemsSource="{Binding QuickInsights}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel>
    </Grid>
    <Border Style="{StaticResource ChartCard}" Margin="0,0,0,16"><StackPanel><DockPanel><TextBlock Text="365-day activity" Style="{StaticResource SectionTitle}"/><TextBlock Text="Click a day to inspect it" DockPanel.Dock="Right" Style="{StaticResource Muted}"/></DockPanel><charts:HeatmapChart ItemsSource="{Binding Heatmap}" ItemClickCommand="{Binding SelectHeatmapDayCommand}" Height="142"/></StackPanel></Border>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource ChartCard}" Margin="0,0,8,0"><StackPanel><DockPanel><TextBlock Text="Time of day" Style="{StaticResource SectionTitle}"/><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding PatternMetrics}" SelectedItem="{Binding PatternMetric}" Width="92"/></DockPanel><charts:BarChart ItemsSource="{Binding Hourly}" Height="190" MaxBarWidth="12"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource ChartCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Day of week" Style="{StaticResource SectionTitle}"/><charts:BarChart ItemsSource="{Binding Weekdays}" Height="190" MaxBarWidth="24"/></StackPanel></Border></Grid>
    <TextBlock Text="Personal records" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding Records}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,2"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Grid></ScrollViewer>
</UserControl>
