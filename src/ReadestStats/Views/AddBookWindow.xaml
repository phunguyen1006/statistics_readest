<Window x:Class="ReadestStats.Views.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:ReadestStats.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ReadestStats.Core;assembly=ReadestStats.Core"
        Title="{loc:Loc Key=sDEE651456D4B794D}"
        Width="1080" Height="760" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
  </Window.Resources>
  <Grid Margin="26,22,26,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{loc:Loc Key=s58C93ADBB6B5CE27}" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="{loc:Loc Key=sF141DDF0FB5E9C7E}" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,5,0,3"/>
        <TextBlock Text="{loc:Loc Key=s09CA368CC4F57CB8}" Style="{StaticResource Muted}"/>
      </StackPanel>
      <Button Grid.Column="1" Content="{loc:Loc Key=s310FF200149B44A3}" Command="{Binding CancelAddBookCommand}" VerticalAlignment="Top"/>
    </Grid>

    <StackPanel Grid.Row="1" Margin="0,20,0,14">
      <TextBlock Text="{loc:Loc Key=sAFF14587F2A69AED}" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox Text="{Binding SearchQuery,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc Key=s3C36CEE85218C61B}"/>
        <Button Grid.Column="1" Content="{loc:Loc Key=s2419329067823CAB}" Command="{Binding SearchBooksCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True"/>
        <Button Grid.Column="2" Content="{loc:Loc Key=sF40A594FE121830E}" Command="{Binding UseManualEntryCommand}" Margin="8,0,0,0" ToolTip="{loc:Loc Key=s161C0AF492CC02AA}"/>
      </Grid>
      <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsSearching,Converter={StaticResource BoolVis}}" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding SearchStatus,Converter={StaticResource UiText}}" Style="{StaticResource Muted}" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,18,0">
        <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}"
                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{loc:Loc Key=sD9168293F0E50C26}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel IsItemsHost="True" Orientation="Horizontal"/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="Width" Value="154"/><Setter Property="MinHeight" Value="238"/>
              <Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Padding" Value="10"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type core:BookMetadataResult}">
              <StackPanel>
                <Border Width="96" Height="138" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" HorizontalAlignment="Left">
                  <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Title}"/>
                </Border>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38" Margin="0,9,0,3"/>
                <TextBlock Text="{Binding Authors}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding PublishedDate}" Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding Source}" Style="{StaticResource Eyebrow}" Margin="0,6,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>

      <Border Grid.Column="1" Background="{DynamicResource Border}"/>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="20,0,0,0">
        <StackPanel>
          <TextBlock Text="{loc:Loc Key=s324D378A354F3BDB}" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="{loc:Loc Key=s987F164DAA6758EF}" Style="{StaticResource SectionTitle}" Margin="0,5,0,14"/>
          <TextBlock Text="{loc:Loc Key=sCFDAF547AB9DAF12}" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/><TextBox Text="{Binding DraftTitle,UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{loc:Loc Key=s636485868971EAC5}" Style="{StaticResource Eyebrow}" Margin="0,12,0,6"/><TextBox Text="{Binding DraftAuthors,UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{loc:Loc Key=sCC89081F21235248}" Style="{StaticResource Eyebrow}" Margin="0,12,0,6"/><TextBox Text="{Binding DraftTotalPages,UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{loc:Loc Key=s4F03A060B7EB0329}" Style="{StaticResource Eyebrow}" Margin="0,12,0,6"/><TextBox Text="{Binding DraftPublisher,UpdateSourceTrigger=PropertyChanged}"/>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Loc Key=sB04E5EA201BB040C}" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/><TextBox Text="{Binding DraftPublishedDate,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{loc:Loc Key=sA4EF304BA42A200B}" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/><TextBox Text="{Binding DraftLanguage,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
          <TextBlock Text="{loc:Loc Key=sE2BEE5ED8084CC09}" Style="{StaticResource Eyebrow}" Margin="0,12,0,6"/><TextBox Text="{Binding DraftGoodreadsUrl,UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{Binding DraftError,Converter={StaticResource UiText}}" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{loc:Loc Key=s21C1B3E8CF5B8D76}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="{loc:Loc Key=s336352DB181DCDFE}" Command="{Binding OpenMetadataCommand}" Margin="0,0,8,0"/>
        <Button Content="{loc:Loc Key=s44239D22FCAE60F3}" Command="{Binding SaveBookCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{loc:Loc Key=s3BC21DDD39D772EB}"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
