<Window x:Class="ReadestStats.Views.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ReadestStats.Core;assembly=ReadestStats.Core"
        Title="Add a physical book · Readest Stats"
        Width="1080" Height="760" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
  </Window.Resources>
  <Grid Margin="26,22,26,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="ADD A PHYSICAL BOOK" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="Find the edition on your shelf" Style="{StaticResource SectionTitle}" FontSize="24" Margin="0,5,0,3"/>
        <TextBlock Text="Search Google Books and Open Library, then verify the details before adding it." Style="{StaticResource Muted}"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Close" Command="{Binding CancelAddBookCommand}" VerticalAlignment="Top"/>
    </Grid>

    <StackPanel Grid.Row="1" Margin="0,20,0,14">
      <TextBlock Text="TITLE, AUTHOR, OR ISBN" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox Text="{Binding SearchQuery,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Book search query"/>
        <Button Grid.Column="1" Content="Search" Command="{Binding SearchBooksCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True"/>
        <Button Grid.Column="2" Content="Enter manually" Command="{Binding UseManualEntryCommand}" Margin="8,0,0,0" ToolTip="Clear metadata fields and type your own book details."/>
      </Grid>
      <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsSearching,Converter={StaticResource BoolVis}}" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding SearchStatus}" Style="{StaticResource Muted}" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,18,0">
        <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}"
                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Matching book editions">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel IsItemsHost="True" Orientation="Horizontal"/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="Width" Value="154"/><Setter Property="MinHeight" Value="238"/>
              <Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Padding" Value="10"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type core:BookMetadataResult}">
              <StackPanel>
                <Border Width="96" Height="138" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" HorizontalAlignment="Left">
                  <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Title}"/>
                </Border>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38" Margin="0,9,0,3"/>
                <TextBlock Text="{Binding Authors}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding PublishedDate}" Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding Source}" Style="{StaticResource Eyebrow}" Margin="0,6,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>

      <Border Grid.Column="1" Background="{DynamicResource Border}"/>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="20,0,0,0">
        <StackPanel>
          <TextBlock Text="BOOK DETAILS" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="Review before adding" Style="{StaticResource SectionTitle}" Margin="0,5,0,14"/>
          <TextBlock Text="Title *" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/><TextBox Text="{Binding DraftTitle,UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Author" Style="{StaticResource Eyebrow}" Margin="0,12,0,6"/><TextBox Text="{Binding DraftAuthors,UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Total pages" Style="{StaticResource Eyebrow}" Margin="0,12,0,6"/><TextBox Text="{Binding DraftTotalPages,UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Publisher" Style="{StaticResource Eyebrow}" Margin="0,12,0,6"/><TextBox Text="{Binding DraftPublisher,UpdateSourceTrigger=PropertyChanged}"/>
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Published" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/><TextBox Text="{Binding DraftPublishedDate,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Language" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/><TextBox Text="{Binding DraftLanguage,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
          <TextBlock Text="Goodreads link (optional)" Style="{StaticResource Eyebrow}" Margin="0,12,0,6"/><TextBox Text="{Binding DraftGoodreadsUrl,UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="{Binding DraftError}" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Manual entry means the details are stored only in Readest Stats; no online match is required." Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="View source" Command="{Binding OpenMetadataCommand}" Margin="0,0,8,0"/>
        <Button Content="Save book" Command="{Binding SaveBookCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Add this book to the physical library"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
