<UserControl x:Class="ReadestStats.Views.NotesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:ReadestStats.Controls" AutomationProperties.Name="Notes library page">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="26,22,26,30" MaxWidth="1380">
      <DockPanel Margin="0,0,0,16">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Random note" Command="{Binding RandomNoteCommand}" Margin="0,0,8,0" AutomationProperties.Name="Show a random note"/>
          <Button Content="Daily note" Command="{Binding DailyNoteCommand}" Margin="0,0,8,0" AutomationProperties.Name="Show today's note"/>
          <Button Content="Refresh" Command="{Binding RefreshNotesCommand}" AutomationProperties.Name="Refresh Readest notes"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="NOTES LIBRARY" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="Your reading, remembered" Style="{StaticResource PageTitle}" Margin="0,3,0,0"/>
          <TextBlock Text="{Binding NotesSummary}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>

      <Border Style="{StaticResource EditorialSection}" Padding="0,0,0,16" Margin="0,0,0,18">
        <StackPanel>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding NoteSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search book, highlight, note, personal note, tags or collections" AutomationProperties.Name="Search notes"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding NoteBookOptions}" SelectedItem="{Binding NoteBookFilter}" Margin="8,0,0,0" AutomationProperties.Name="Filter notes by book"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding NoteReviewFilters}" SelectedItem="{Binding NoteReviewFilter}" Margin="8,0,0,0" AutomationProperties.Name="Filter notes by review status"/>
            <ComboBox Grid.Column="3" ItemsSource="{Binding NoteSorts}" SelectedItem="{Binding NoteSort}" Margin="8,0,0,0" AutomationProperties.Name="Sort notes"/>
          </Grid>
          <WrapPanel>
            <ComboBox ItemsSource="{Binding NoteTypeOptions}" SelectedItem="{Binding NoteTypeFilter}" Width="130" Margin="0,0,8,0" AutomationProperties.Name="Filter notes by type"/>
            <ComboBox ItemsSource="{Binding NoteColorOptions}" SelectedItem="{Binding NoteColorFilter}" Width="130" Margin="0,0,8,0" AutomationProperties.Name="Filter notes by color"/>
            <ComboBox ItemsSource="{Binding NoteTagOptions}" SelectedItem="{Binding NoteTagFilter}" Width="130" Margin="0,0,8,0" AutomationProperties.Name="Filter notes by tag"/>
            <ComboBox ItemsSource="{Binding NoteCollectionOptions}" SelectedItem="{Binding NoteCollectionFilter}" Width="150" Margin="0,0,8,0" AutomationProperties.Name="Filter notes by collection"/>
            <ComboBox ItemsSource="{Binding NoteDateFilters}" SelectedItem="{Binding NoteDateFilter}" Width="118" Margin="0,0,8,0" ToolTip="Filter by note date" AutomationProperties.Name="Filter notes by date"/>
            <ComboBox ItemsSource="{Binding NoteContentFilters}" SelectedItem="{Binding NoteContentFilter}" Width="148" Margin="0,0,8,0" ToolTip="Filter by note content" AutomationProperties.Name="Filter notes by content"/>
            <ComboBox ItemsSource="{Binding NoteVisibilityFilters}" SelectedItem="{Binding NoteVisibilityFilter}" Width="130" AutomationProperties.Name="Filter note visibility"/>
            <CheckBox Content="Favorites only" IsChecked="{Binding NotesFavoritesOnly}" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Show favorite notes only"/>
            <ComboBox ItemsSource="{Binding NoteRandomModes}" SelectedItem="{Binding NoteRandomMode}" Width="132" Margin="12,0,0,0" ToolTip="Choose the pool used by Random note" AutomationProperties.Name="Random note mode"/>
            <TextBlock Text="{Binding NotesCountLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <UniformGrid Columns="4" Margin="0,0,0,20">
        <StackPanel><TextBlock Text="TOTAL NOTES" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding TotalNotes}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="FAVORITES" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding FavoriteNotesCount}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="DUE FOR REVIEW" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ReviewQueueCount}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="NOTES SEEN" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding NotesReadCount}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
      </UniformGrid>

      <Grid Height="410" Margin="0,0,0,26">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
        <Grid>
        <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Readest notes">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0,0,16,12"/>
              <Setter Property="Margin" Value="0,0,0,12"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHover}"/></Trigger>
                      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceActive}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter TargetName="Row" Property="BorderThickness" Value="0,0,0,2"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Eyebrow}"/>
                  <TextBlock Text="{Binding PageLabel}" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="14,0,12,0">
                  <TextBlock Text="{Binding BookTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding BookTitle}"/>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="42" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondary}" TextTrimming="WordEllipsis"/>
                  <TextBlock Text="{Binding Note}" TextWrapping="Wrap" MaxHeight="38" Margin="0,4,0,0" Style="{StaticResource Muted}" TextTrimming="WordEllipsis" Visibility="{Binding HasComment,Converter={StaticResource BoolVis}}"/>
                  <TextBlock Text="{Binding TagsText,StringFormat=Tags: {0}}" Style="{StaticResource Muted}" Margin="0,5,0,0" Visibility="{Binding HasTags,Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                  <Button Content="Fav" Command="{Binding DataContext.ToggleFavoriteNoteCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="{Binding FavoriteLabel}" AutomationProperties.Name="{Binding FavoriteLabel}" Padding="7,4" MinHeight="28"/>
                  <TextBlock Text="{Binding ReviewLabel}" Style="{StaticResource Muted}" TextAlignment="Right" Margin="0,8,0,0"/>
                  <TextBlock Text="{Binding DisplayDate}" Style="{StaticResource Muted}" TextAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoVisibleNotes,Converter={StaticResource BoolVis}}" IsHitTestVisible="False">
          <TextBlock Text="{Binding NotesEmptyMessage}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
          <TextBlock Text="Try changing a filter or refresh the Readest library." Style="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource EditorialAside}" Margin="20,0,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="NOTE DETAIL" Style="{StaticResource Eyebrow}"/>
              <TextBlock Text="{Binding SelectedNote.BookTitle}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,2"/>
              <TextBlock Text="{Binding SelectedNote.Authors}" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
              <WrapPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding SelectedNote.PageLabel}" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="  ·  " Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding SelectedNote.TypeLabel}" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="  ·  " Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding SelectedNote.ColorLabel}" Foreground="{DynamicResource TextSecondary}"/>
              </WrapPanel>
              <TextBlock Text="HIGHLIGHT" Style="{StaticResource Eyebrow}"/>
              <TextBlock Text="{Binding SelectedNote.Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,12"/>
              <TextBlock Text="READest NOTE" Style="{StaticResource Eyebrow}" Visibility="{Binding SelectedNote.HasComment,Converter={StaticResource BoolVis}}"/>
              <TextBlock Text="{Binding SelectedNote.Note}" TextWrapping="Wrap" Margin="0,5,0,14" Visibility="{Binding SelectedNote.HasComment,Converter={StaticResource BoolVis}}"/>
              <Separator Background="{DynamicResource Border}" Margin="0,0,0,14"/>
              <TextBlock Text="MY NOTE" Style="{StaticResource Eyebrow}"/>
              <TextBox Text="{Binding SelectedNote.PersonalNote,UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" Margin="0,5,0,12" AutomationProperties.Name="Personal note"/>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="TAGS" Style="{StaticResource Eyebrow}"/><TextBox Text="{Binding SelectedNote.TagsText,UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" ToolTip="Comma-separated tags" AutomationProperties.Name="Note tags"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="COLLECTIONS" Style="{StaticResource Eyebrow}"/><TextBox Text="{Binding SelectedNote.CollectionsText,UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" ToolTip="Comma-separated collections" AutomationProperties.Name="Note collections"/></StackPanel>
              </Grid>
              <TextBlock Text="{Binding SelectedNote.ReviewLabel}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
              <WrapPanel Margin="0,0,0,12">
                <Button Content="Remembered" Command="{Binding ReviewNoteCommand}" CommandParameter="Remembered" Margin="0,0,6,6" AutomationProperties.Name="Mark note remembered"/>
                <Button Content="Review later" Command="{Binding ReviewNoteCommand}" CommandParameter="Needs review" Margin="0,0,6,6" AutomationProperties.Name="Schedule note for review"/>
                <Button Content="Save" Command="{Binding SaveSelectedNoteCommand}" Margin="0,0,6,6" AutomationProperties.Name="Save note settings"/>
              </WrapPanel>
              <WrapPanel>
                <Button Content="Open in Readest" Command="{Binding OpenSelectedNoteCommand}" Margin="0,0,6,6" AutomationProperties.Name="Open note book in Readest"/>
                <Button Content="Hide note" Command="{Binding ToggleHiddenNoteCommand}" CommandParameter="{Binding SelectedNote}" Margin="0,0,6,6" AutomationProperties.Name="Hide selected note"/>
              </WrapPanel>
              <TextBlock Text="{Binding NotesStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <Border Style="{StaticResource EditorialSection}" Padding="0,0,0,22" Margin="0,0,0,22">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Markdown" Command="{Binding ExportNotesMarkdownCommand}" Margin="0,0,6,0" AutomationProperties.Name="Export notes as Markdown"/>
              <Button Content="JSON" Command="{Binding ExportNotesJsonCommand}" Margin="0,0,6,0" AutomationProperties.Name="Export notes as JSON"/>
              <Button Content="CSV" Command="{Binding ExportNotesCsvCommand}" AutomationProperties.Name="Export notes as CSV"/>
            </StackPanel>
            <StackPanel><TextBlock Text="NOTE ANALYTICS" Style="{StaticResource Eyebrow}"/><TextBlock Text="What your saved reading is concentrating on" Style="{StaticResource SectionTitle}" Margin="0,3,0,0"/></StackPanel>
          </DockPanel>
          <Grid>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,22,0"><TextBlock Text="NOTES BY BOOK" Style="{StaticResource Eyebrow}"/><charts:BarChart ItemsSource="{Binding NotesByBook}" Height="150" MaxBarWidth="22" AutomationProperties.Name="Notes by book"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,22,0"><TextBlock Text="NOTES OVER TIME" Style="{StaticResource Eyebrow}"/><charts:LineChart ItemsSource="{Binding NotesByMonth}" Height="150" AutomationProperties.Name="Notes over time"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="NOTE TYPES" Style="{StaticResource Eyebrow}"/><charts:BarChart ItemsSource="{Binding NotesByType}" Height="150" MaxBarWidth="18" AutomationProperties.Name="Notes by type"/></StackPanel>
            <StackPanel Grid.Row="1" Margin="0,18,22,0"><TextBlock Text="TOP TAGS" Style="{StaticResource Eyebrow}"/><charts:BarChart ItemsSource="{Binding NotesByTag}" Height="140" MaxBarWidth="18" AutomationProperties.Name="Notes by tag"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,18,22,0"><TextBlock Text="NOTE COLORS" Style="{StaticResource Eyebrow}"/><charts:BarChart ItemsSource="{Binding NotesByColor}" Height="140" MaxBarWidth="18" AutomationProperties.Name="Notes by color"/></StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
