<UserControl x:Class="ReadestStats.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:ReadestStats.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:ReadestStats.Controls"
             AutomationProperties.Name="{loc:Loc Key=s101012A8481F9238}">
  <UserControl.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding RandomNoteCommand}"/>
  </UserControl.InputBindings>
  <UserControl.Resources>
    <Style x:Key="NoteSpotlight" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceAlt}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18,16"/>
    </Style>

    <Style x:Key="HeartButton" TargetType="Button">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="HeartBody"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <Viewbox>
                <Path x:Name="HeartGlyph"
                      Data="M12,21.1 L10.55,19.78 C5.4,15.11 2,12.03 2,8.25 C2,5.17 4.42,2.75 7.5,2.75 C9.24,2.75 10.91,3.56 12,4.84 C13.09,3.56 14.76,2.75 16.5,2.75 C19.58,2.75 22,5.17 22,8.25 C22,12.03 18.6,15.11 13.45,19.78 Z"
                      Fill="Transparent"
                      Stroke="{DynamicResource TextPrimary}"
                      StrokeThickness="1.7"
                      StrokeLineJoin="Round"/>
              </Viewbox>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                <Setter TargetName="HeartGlyph" Property="Fill" Value="{DynamicResource TextPrimary}"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeartBody" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                <Setter TargetName="HeartBody" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HeartBody" Property="Background" Value="{DynamicResource SurfaceActive}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="HeartBody" Property="BorderBrush" Value="{DynamicResource Focus}"/>
                <Setter TargetName="HeartBody" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="26,22,26,30" MaxWidth="1380">
      <DockPanel Margin="0,0,0,18">
        <Button DockPanel.Dock="Right"
                Content="{loc:Loc Key=sD6CC0A088C07683C}"
                Command="{Binding RefreshNotesCommand}"
                Padding="9,4"
                MinHeight="30"
                FontSize="12"
                VerticalAlignment="Top"
                AutomationProperties.Name="{loc:Loc Key=sDC7CABBA4126A5EF}"/>
        <StackPanel>
          <TextBlock Text="{loc:Loc Key=sDBA44BA0BC90C9B8}" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="{loc:Loc Key=sB0CD210809CC1FDF}" Style="{StaticResource PageTitle}" Margin="0,3,0,0"/>
          <TextBlock Text="{Binding NotesSummary,Converter={StaticResource UiText}}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>

      <Grid Margin="0,0,0,22" Height="176">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource NoteSpotlight}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding DailyNote.DisplayDate}" Style="{StaticResource Muted}"/>
              <TextBlock Text="{loc:Loc Key=s7713FBD0D7A6630D}" Style="{StaticResource Eyebrow}"/>
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,10,0,8">
              <TextBlock Text="{Binding DailyNote.BookTitle}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding DailyNote.Text}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="42" Margin="0,6,0,0"/>
              <TextBlock Text="{Binding DailyNote.PageLabel,Converter={StaticResource UiText}}" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Row="2"
                    Content="{loc:Loc Key=s9FB0883938A1CFA9}"
                    Command="{Binding DailyNoteCommand}"
                    HorizontalAlignment="Left"
                    Padding="10,5"
                    MinHeight="30"
                    FontSize="12"
                    AutomationProperties.Name="{loc:Loc Key=s54D85420C545DB90}"/>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource NoteSpotlight}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Loc Key=s6DEC531AE4573E4A}" Style="{StaticResource Eyebrow}"/><ComboBox ItemTemplate="{StaticResource LocalizedOption}" Grid.Column="1" ItemsSource="{Binding RandomNotePools}" SelectedItem="{Binding RandomNotePool}" Width="154" MinHeight="28" AutomationProperties.Name="{loc:Loc Key=s2A7925ED02578904}"/></Grid>
            <StackPanel Grid.Row="1" Margin="0,10,0,8">
              <TextBlock Text="{Binding RandomNote.BookTitle}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding RandomNote.Text}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="42" Margin="0,6,0,0"/>
              <TextBlock Text="{Binding RandomNote.PageLabel,Converter={StaticResource UiText}}" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="{loc:Loc Key=s37377C6D3A432F8A}" Command="{Binding RandomNoteCommand}" HorizontalAlignment="Left" Padding="10,5" MinHeight="30" FontSize="12" ToolTip="{loc:Loc Key=s7D0857E4AF3A0BA1}" AutomationProperties.Name="{loc:Loc Key=sBBAD0110868D0A25}"/><Button Content="{loc:Loc Key=s3C482346F3750276}" Command="{Binding PreviousRandomNoteCommand}" Padding="10,5" MinHeight="30" FontSize="12" Margin="6,0,0,0" AutomationProperties.Name="{loc:Loc Key=s7097182C7174D7FC}"/></StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Border Style="{StaticResource EditorialSection}" Margin="0,0,0,20"><StackPanel><TextBlock Text="{loc:Loc Key=sEDBC19F22446EFBF}" Style="{StaticResource Eyebrow}"/><ItemsControl ItemsSource="{Binding RandomNoteHistory}" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectNoteCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Margin="0,0,8,0" Padding="10,7"><StackPanel><TextBlock Text="{Binding BookTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>

      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="0,2,22,4">
          <StackPanel>
            <TextBlock Text="{loc:Loc Key=s5D1F81FA6E2A53B5}" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="{Binding TotalNotes}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="22,2,22,4">
          <StackPanel>
            <TextBlock Text="{loc:Loc Key=sF42D0F9E4B0EC07D}" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="{Binding FavoriteNotesCount}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Padding="22,2,0,4">
          <StackPanel>
            <TextBlock Text="{loc:Loc Key=s32D87DC12BDAB85E}" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="{Binding NotesReadCount}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <Expander Header="{loc:Loc Key=s35652C0294E70E37}" Margin="0,0,0,10" AutomationProperties.Name="{loc:Loc Key=sC87CA0A79B80F16C}"><Grid Margin="0,8,0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBox Text="{Binding NoteSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc Key=sE3141B03AFB003AF}"/><ComboBox ItemTemplate="{StaticResource LocalizedOption}" Grid.Column="1" ItemsSource="{Binding NoteScopeOptions}" SelectedItem="{Binding NoteScope}" Margin="8,0,0,0" AutomationProperties.Name="{loc:Loc Key=s3EB55F19C21505B3}"/></Grid></Expander>
      <Grid Height="430" Margin="0,0,0,26">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.35*"/>
          <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid>
          <ListBox ItemsSource="{Binding Notes}"
                   SelectedItem="{Binding SelectedNote}"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.CanContentScroll="True"
                   VirtualizingStackPanel.IsVirtualizing="True"
                   VirtualizingStackPanel.VirtualizationMode="Recycling"
                   AutomationProperties.Name="{loc:Loc Key=s01DEDE4E0AE0B238}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="12,12,10,13"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Row"
                              Background="Transparent"
                              BorderBrush="{DynamicResource Border}"
                              BorderThickness="0,0,0,1"
                              CornerRadius="6"
                              Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceActive}"/>
                          <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Focus}"/>
                          <Setter TargetName="Row" Property="BorderThickness" Value="1"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="92"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding TypeLabel,Converter={StaticResource UiText}}" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="{Binding PageLabel,Converter={StaticResource UiText}}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="12,0,16,0">
                    <TextBlock Text="{Binding BookTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding BookTitle}"/>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="43" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondary}" TextTrimming="WordEllipsis"/>
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" MaxHeight="36" Margin="0,5,0,0" Style="{StaticResource Muted}" TextTrimming="WordEllipsis" Visibility="{Binding HasComment,Converter={StaticResource BoolVis}}"/>
                  </StackPanel>
                  <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Button Style="{StaticResource HeartButton}"
                            Command="{Binding DataContext.ToggleFavoriteNoteCommand,RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"
                            ToolTip="{Binding FavoriteLabel}"
                            AutomationProperties.Name="{Binding FavoriteLabel}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="1" Text="{Binding DisplayDate}" Style="{StaticResource Muted}" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{Binding HasNoVisibleNotes,Converter={StaticResource BoolVis}}"
                      IsHitTestVisible="False">
            <TextBlock Text="{Binding NotesEmptyMessage,Converter={StaticResource UiText}}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
            <TextBlock Text="{loc:Loc Key=sF11BBE4DC5987021}" Style="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource EditorialAside}" Margin="20,0,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="{loc:Loc Key=s75986CAECFDF887A}" Style="{StaticResource Eyebrow}"/>
              <TextBlock Text="{Binding SelectedNote.BookTitle}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,2"/>
              <TextBlock Text="{Binding SelectedNote.Authors}" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
              <WrapPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding SelectedNote.PageLabel,Converter={StaticResource UiText}}" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="  ·  " Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding SelectedNote.TypeLabel,Converter={StaticResource UiText}}" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="  ·  " Style="{StaticResource Muted}"/>
                <TextBlock Text="{Binding SelectedNote.ColorLabel}" Foreground="{DynamicResource TextSecondary}"/>
              </WrapPanel>
              <TextBlock Text="{loc:Loc Key=sDC2C5BE187F6F31E}" Style="{StaticResource Eyebrow}"/>
              <TextBlock Text="{Binding SelectedNote.Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,12"/>
              <TextBlock Text="{loc:Loc Key=s658374D5B52B8468}" Style="{StaticResource Eyebrow}" Visibility="{Binding SelectedNote.IsReadest,Converter={StaticResource BoolVis}}"/>
              <TextBlock Text="{Binding SelectedNote.Note}" TextWrapping="Wrap" Margin="0,5,0,14" Visibility="{Binding SelectedNote.IsReadest,Converter={StaticResource BoolVis}}"/>
              <TextBlock Text="{loc:Loc Key=s1D23F8062C74779D}" Style="{StaticResource Eyebrow}" Visibility="{Binding SelectedNote.IsManual,Converter={StaticResource BoolVis}}"/>
              <TextBox Text="{Binding SelectedNote.Note,UpdateSourceTrigger=LostFocus}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="62"
                       Margin="0,5,0,14"
                       Visibility="{Binding SelectedNote.IsManual,Converter={StaticResource BoolVis}}"
                       AutomationProperties.Name="{loc:Loc Key=sB424B2C4D6E21E54}"/>
              <Separator Background="{DynamicResource Border}" Margin="0,0,0,14"/>
              <TextBlock Text="{loc:Loc Key=sCEC25C1AF6F55332}" Style="{StaticResource Eyebrow}"/>
              <TextBox Text="{Binding SelectedNote.PersonalNote,UpdateSourceTrigger=LostFocus}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="62"
                       Margin="0,5,0,12"
                       AutomationProperties.Name="{loc:Loc Key=s14F7491B4452D088}"/>
              <WrapPanel>
                <Button Content="{loc:Loc Key=s726F030F4F9885DD}" Command="{Binding OpenSelectedNoteCommand}" Margin="0,0,6,6" AutomationProperties.Name="{loc:Loc Key=s3D6AF5C4ADCB9543}"/>
                <Button Content="{loc:Loc Key=s0C747FC31800DFD6}" Command="{Binding RandomSameBookCommand}" Margin="0,0,6,6" AutomationProperties.Name="{loc:Loc Key=sCB7F9FCAF8606D44}"/>
                <Button Content="{loc:Loc Key=s6F5A6034E770ACBF}" Command="{Binding CopySelectedNoteCommand}" Margin="0,0,6,6" AutomationProperties.Name="{loc:Loc Key=s49001AA2BCCCD29D}"/>
                <Button Content="{loc:Loc Key=sC6CC81218590503A}" Command="{Binding CopyNoteCitationCommand}" Margin="0,0,6,6" AutomationProperties.Name="{loc:Loc Key=s50FB10BBFC2F8ED7}"/>
                <Button Content="{loc:Loc Key=s157DCA92E4250458}" Command="{Binding SaveSelectedNoteCommand}" Margin="0,0,6,6" AutomationProperties.Name="{loc:Loc Key=s79C53F5281DD4174}"/>
                <Button Content="{loc:Loc Key=sBAFD151A86F9A573}" Command="{Binding SnoozeNoteForCommand}" CommandParameter="1" Margin="0,0,6,6" ToolTip="{loc:Loc Key=sF0D4682C1E85C59E}"/>
                <Button Content="{loc:Loc Key=s28FA44AFA0899BD5}" Command="{Binding SnoozeNoteForCommand}" CommandParameter="7" Margin="0,0,6,6" ToolTip="{loc:Loc Key=sC1A30E72ACC5B238}"/>
                <Button Content="{loc:Loc Key=sCF13AE5171A6EBDA}" Command="{Binding SnoozeNoteForCommand}" CommandParameter="30" Margin="0,0,6,6" ToolTip="{loc:Loc Key=s79BF8513B3570F0D}"/>
                <Button Content="{Binding SelectedNote.RandomEligibilityLabel,Converter={StaticResource UiText}}" Command="{Binding ToggleRandomEligibilityCommand}" Margin="0,0,6,6" ToolTip="{loc:Loc Key=s26B2FD4FD470CE35}"/>
              </WrapPanel>
              <TextBlock Text="{Binding SelectedNote.SnoozeLabel,Converter={StaticResource UiText}}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding NotesStatus,Converter={StaticResource UiText}}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <Border Style="{StaticResource EditorialSection}" Padding="0,0,0,22" Margin="0,0,0,22">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Markdown" Command="{Binding ExportNotesMarkdownCommand}" Margin="0,0,6,0" AutomationProperties.Name="{loc:Loc Key=s3AE36E209BD6D651}"/>
              <Button Content="JSON" Command="{Binding ExportNotesJsonCommand}" Margin="0,0,6,0" AutomationProperties.Name="{loc:Loc Key=s978204DCEDEA696C}"/>
              <Button Content="CSV" Command="{Binding ExportNotesCsvCommand}" AutomationProperties.Name="{loc:Loc Key=s215B272CB8370F4F}"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{loc:Loc Key=sB2CB52CD2953ED94}" Style="{StaticResource Eyebrow}"/>
              <TextBlock Text="{loc:Loc Key=s8D66A8F64CF06CAC}" Style="{StaticResource SectionTitle}" Margin="0,3,0,0"/>
            </StackPanel>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.2*"/>
              <ColumnDefinition Width="1.2*"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,22,0">
              <TextBlock Text="{loc:Loc Key=sA1E8237E6D8CD835}" Style="{StaticResource Eyebrow}"/>
              <charts:BarChart ItemsSource="{Binding NotesByBook}" Height="150" MaxBarWidth="22" AutomationProperties.Name="{loc:Loc Key=sA1E8237E6D8CD835}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,22,0">
              <TextBlock Text="{loc:Loc Key=sD27050A07E3D5B9A}" Style="{StaticResource Eyebrow}"/>
              <charts:LineChart ItemsSource="{Binding NotesByMonth}" Height="150" AutomationProperties.Name="{loc:Loc Key=sD27050A07E3D5B9A}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{loc:Loc Key=s7BC86827AB5F89B2}" Style="{StaticResource Eyebrow}"/>
              <charts:BarChart ItemsSource="{Binding NotesByType}" Height="150" MaxBarWidth="18" AutomationProperties.Name="{loc:Loc Key=s75F3D889DA9C7B1E}"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
