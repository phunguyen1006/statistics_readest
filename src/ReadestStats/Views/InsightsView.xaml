<UserControl x:Class="ReadestStats.Views.InsightsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:ReadestStats.Controls" AutomationProperties.Name="Insights page">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,22,26,28" MaxWidth="1320">
    <UniformGrid Columns="4" Margin="0,0,0,16"><charts:StatCard Label="CONSISTENCY" Value="{Binding Period.ConsistencyPercent,StringFormat={}{0:0}%}" Detail="{Binding ConsistencyDetail}" Help="Active reading days divided by eligible days in the selected period."/><charts:StatCard Label="TYPICAL SESSION" Value="{Binding SessionProfile.Median,Converter={StaticResource Duration}}" Detail="Median active reading"/><charts:StatCard Label="COMMON WINDOW" Value="{Binding CommonWindowLabel}" Detail="{Binding CommonWindow.Share,StringFormat={}{0:P0} of reading}"/><charts:StatCard Label="AVG / CALENDAR DAY" Value="{Binding Period.AveragePerCalendarDay,Converter={StaticResource Duration}}" Detail="Eligible days only"/></UniformGrid>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource ChartCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Session profile" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SHORTEST" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SessionProfile.Shortest,Converter={StaticResource Duration}}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="AVERAGE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SessionProfile.Average,Converter={StaticResource Duration}}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="LONGEST" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SessionProfile.Longest,Converter={StaticResource Duration}}"/></StackPanel></Grid><charts:BarChart ItemsSource="{Binding SessionHistogram}" Height="175" MaxBarWidth="30" Margin="0,10,0,0"/><TextBlock Style="{StaticResource Muted}"><Run Text="Middle half: "/><Run Text="{Binding SessionProfile.P25,Converter={StaticResource Duration}}"/><Run Text=" – "/><Run Text="{Binding SessionProfile.P75,Converter={StaticResource Duration}}"/></TextBlock></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Weekday vs weekend" Style="{StaticResource SectionTitle}"/><UniformGrid Columns="2"><StackPanel><TextBlock Text="WEEKDAY AVG" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding WeekdayWeekend.AverageWeekdaySeconds,Converter={StaticResource Duration}}" FontSize="22" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="WEEKEND AVG" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding WeekdayWeekend.AverageWeekendSeconds,Converter={StaticResource Duration}}" FontSize="22" FontWeight="SemiBold"/></StackPanel></UniformGrid><TextBlock Text="{Binding WeekdayWeekend.Summary}" Style="{StaticResource Muted}" Margin="0,14,0,0"/></StackPanel></Border></Grid>
    <TextBlock Text="Derived insights" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding AllInsights}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="380" MinHeight="116" Margin="0,0,12,12"><StackPanel><DockPanel><TextBlock Text="{Binding SampleStatus}" DockPanel.Dock="Right" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Category}" Style="{StaticResource Eyebrow}"/></DockPanel><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></ScrollViewer>
</UserControl>
