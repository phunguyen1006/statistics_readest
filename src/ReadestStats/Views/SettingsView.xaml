<UserControl x:Class="ReadestStats.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.Name="Settings page">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,22,26,28" MaxWidth="1000"><TextBlock Text="DATA SOURCE" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Readest data path" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Diagnostics.Path}" FontFamily="Cascadia Mono,Consolas" TextWrapping="Wrap" Margin="0,5,0,12"/><WrapPanel><Button Content="Change database" Command="{Binding ChangeDatabaseCommand}" Margin="0,0,8,0"/><Button Content="Re-detect" Command="{Binding RedetectCommand}" Margin="0,0,8,0"/><Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"/><Button Content="Reconnect" Command="{Binding RefreshCommand}"/></WrapPanel></StackPanel></Border>
    <TextBlock Text="DATA HEALTH" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><UniformGrid Columns="3"><StackPanel Margin="0,0,12,14"><TextBlock Text="READEST CONNECTION" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Status}" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="0,0,12,14"><TextBlock Text="STATISTICS DATABASE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Available" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="0,0,0,14"><TextBlock Text="LAST ACTIVITY" Style="{StaticResource Eyebrow}"/><TextBlock Margin="0,4,0,0"><TextBlock.Text><MultiBinding Converter="{StaticResource Clock}" ConverterParameter="full-date-time"><Binding Path="Diagnostics.LatestEvent"/><Binding Path="Use24HourTime"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel><StackPanel><TextBlock Text="EVENTS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Diagnostics.Events}" Margin="0,4,0,0"/></StackPanel><StackPanel><TextBlock Text="SESSIONS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding AllSessionCount}" Margin="0,4,0,0"/></StackPanel><StackPanel><TextBlock Text="PAGE METRICS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding PageMetricReliability}" Margin="0,4,0,0"/></StackPanel></UniformGrid></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DATA QUALITY" Style="{StaticResource Eyebrow}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,2"><TextBlock Text="{Binding DataQuality.Score}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text=" / 100" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Bottom" Margin="2,0,0,3"/></StackPanel><TextBlock Text="{Binding DataQuality.Status}" Foreground="{DynamicResource TextSecondary}"/></StackPanel><Button Grid.Column="1" Content="Run checks" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/></Grid>
      <Expander Header="Quality checks" Margin="0,12,0,0" Foreground="{DynamicResource TextPrimary}"><ItemsControl ItemsSource="{Binding DataQualityChecks}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5" ToolTip="{Binding Evidence}"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Muted}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
    </StackPanel></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="REFRESH" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Refresh behavior" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding RefreshModes}" SelectedItem="{Binding RefreshMode}" Margin="0,6,0,0"/></StackPanel></Border><TextBlock Text="READING STATISTICS" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Session gap (minutes)" Style="{StaticResource Muted}"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding SessionGapMinutes}" Margin="0,5,0,10"><ComboBoxItem Content="2"/><ComboBoxItem Content="5"/><ComboBoxItem Content="10"/><ComboBoxItem Content="15"/></ComboBox><TextBlock Text="Minimum valid session (seconds)" Style="{StaticResource Muted}"/><TextBox Text="{Binding MinimumSessionSeconds}" Margin="0,5,0,10"/><TextBlock Text="Start of week" Style="{StaticResource Muted}"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding FirstDayOfWeek}" Margin="0,5,0,10"><ComboBoxItem Content="Monday"/><ComboBoxItem Content="Sunday"/></ComboBox><CheckBox Content="Experimental page metrics" IsChecked="{Binding ExperimentalPageMetrics}" ToolTip="Page-based values can change with pagination, layout, font size, or reading engine."/></StackPanel></Border></StackPanel>
      <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="DISPLAY" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Appearance" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" Margin="0,6,0,10" AutomationProperties.Name="Color theme"/><CheckBox Content="Compact mode" IsChecked="{Binding CompactMode}"/><CheckBox Content="Use 24-hour time" IsChecked="{Binding Use24HourTime}"/><CheckBox Content="Reduce motion" IsChecked="{Binding ReduceMotion}"/></StackPanel></Border><TextBlock Text="DATA" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><Button Content="Export selected-range CSV" Command="{Binding ExportCsvCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/><Button Content="Export summary JSON" Command="{Binding ExportJsonCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/><Button Content="Export monthly Markdown report" Command="{Binding ExportMonthlyReportCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8" ToolTip="Uses the month currently shown on Activity."/><Button Content="Backup goals and settings" Command="{Binding BackupSettingsCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/><Button Content="Reset app-owned settings" Command="{Binding ResetSettingsCommand}" HorizontalAlignment="Stretch" ToolTip="Does not change Readest's database."/></StackPanel></Border><TextBlock Text="ABOUT" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="VERSION" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding AppVersion}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,10"/><TextBlock Text="BUILD DATE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BuildDate}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="COMMIT" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BuildCommit}" FontFamily="Cascadia Mono,Consolas" FontSize="16" Margin="0,4,0,10"/><TextBlock Text="FULL SCREEN" Style="{StaticResource Eyebrow}"/><TextBlock Text="F11 toggles · Esc exits" Margin="0,4,0,0"/></StackPanel></Grid><Separator Margin="0,14" Background="{DynamicResource Border}"/><TextBlock Text="UPDATES" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding UpdateStatus}" Margin="0,5,0,8"/><WrapPanel><Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,0"/><Button Content="Open releases" Command="{Binding OpenUpdateCommand}"/></WrapPanel></StackPanel></Border></StackPanel></Grid>
    <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="AUTOMATIC BACKUPS" Style="{StaticResource Eyebrow}"/><CheckBox Content="Keep seven daily settings backups" IsChecked="{Binding AutomaticBackups}" Margin="0,8,0,2"/><TextBlock Text="Ctrl+1–8 navigate · Ctrl+R refresh · F11 full screen · Esc exit full screen" Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
    <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
  </StackPanel></ScrollViewer>
</UserControl>
