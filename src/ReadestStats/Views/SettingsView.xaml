<UserControl x:Class="ReadestStats.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.Name="Settings page">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,22,26,28" MaxWidth="1000"><TextBlock Text="DATA SOURCE" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Readest data path" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Diagnostics.Path}" FontFamily="Cascadia Mono,Consolas" TextWrapping="Wrap" Margin="0,5,0,12"/><WrapPanel><Button Content="Change database" Command="{Binding ChangeDatabaseCommand}" Margin="0,0,8,0"/><Button Content="Re-detect" Command="{Binding RedetectCommand}" Margin="0,0,8,0"/><Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"/><Button Content="Reconnect" Command="{Binding RefreshCommand}"/></WrapPanel></StackPanel></Border>
    <TextBlock Text="DATA HEALTH" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><UniformGrid Columns="3"><StackPanel Margin="0,0,12,14"><TextBlock Text="READEST CONNECTION" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Status}" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="0,0,12,14"><TextBlock Text="STATISTICS DATABASE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Available" Margin="0,4,0,0"/></StackPanel><StackPanel Margin="0,0,0,14"><TextBlock Text="LAST ACTIVITY" Style="{StaticResource Eyebrow}"/><TextBlock Margin="0,4,0,0"><TextBlock.Text><MultiBinding Converter="{StaticResource Clock}" ConverterParameter="full-date-time"><Binding Path="Diagnostics.LatestEvent"/><Binding Path="Use24HourTime"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel><StackPanel><TextBlock Text="EVENTS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Diagnostics.Events}" Margin="0,4,0,0"/></StackPanel><StackPanel><TextBlock Text="SESSIONS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding AllSessionCount}" Margin="0,4,0,0"/></StackPanel><StackPanel><TextBlock Text="PAGE METRICS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding PageMetricReliability}" Margin="0,4,0,0"/></StackPanel></UniformGrid></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="REFRESH" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Refresh behavior" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding RefreshModes}" SelectedItem="{Binding RefreshMode}" Margin="0,6,0,0"/><TextBlock Text="File-change mode uses a 1.5-second debounce and does not poll continuously." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border><TextBlock Text="READING STATISTICS" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Session gap (minutes)" Style="{StaticResource Muted}"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding SessionGapMinutes}" Margin="0,5,0,10"><ComboBoxItem Content="2"/><ComboBoxItem Content="5"/><ComboBoxItem Content="10"/><ComboBoxItem Content="15"/></ComboBox><TextBlock Text="Minimum valid session (seconds)" Style="{StaticResource Muted}"/><TextBox Text="{Binding MinimumSessionSeconds}" Margin="0,5,0,10"/><TextBlock Text="Start of week" Style="{StaticResource Muted}"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding FirstDayOfWeek}" Margin="0,5,0,10"><ComboBoxItem Content="Monday"/><ComboBoxItem Content="Sunday"/></ComboBox><CheckBox Content="Experimental page metrics" IsChecked="{Binding ExperimentalPageMetrics}"/><TextBlock Text="Page-based statistics can vary when pagination, layout, font size, or reading engine changes." Style="{StaticResource Muted}" Margin="22,2,0,0"/></StackPanel></Border></StackPanel>
      <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="DISPLAY" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Appearance" Style="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" Margin="0,6,0,10" AutomationProperties.Name="Color theme"/><CheckBox Content="Compact mode" IsChecked="{Binding CompactMode}"/><CheckBox Content="Use 24-hour time" IsChecked="{Binding Use24HourTime}"/><CheckBox Content="Reduce motion" IsChecked="{Binding ReduceMotion}"/><TextBlock Text="Dark, light, and system themes apply immediately. Compact mode tightens cards, tables, and navigation. Time format applies throughout the app." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border><TextBlock Text="DATA" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><Button Content="Export selected-range CSV" Command="{Binding ExportCsvCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/><Button Content="Export summary JSON" Command="{Binding ExportJsonCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/><Button Content="Backup goals and settings" Command="{Binding BackupSettingsCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/><Button Content="Reset app-owned settings" Command="{Binding ResetSettingsCommand}" HorizontalAlignment="Stretch"/><TextBlock Text="Reset never deletes or changes Readest's database." Style="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel></Border><TextBlock Text="ABOUT" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="VERSION" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding AppVersion}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,10"/><TextBlock Text="BUILD DATE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BuildDate}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="COMMIT" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BuildCommit}" FontFamily="Cascadia Mono,Consolas" FontSize="16" Margin="0,4,0,10"/><TextBlock Text="FULL SCREEN" Style="{StaticResource Eyebrow}"/><TextBlock Text="F11 toggles · Esc exits" Margin="0,4,0,0"/></StackPanel></Grid></Border></StackPanel></Grid>
    <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
  </StackPanel></ScrollViewer>
</UserControl>
