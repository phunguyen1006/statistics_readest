<UserControl x:Class="ReadestStats.Views.YearView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:ReadestStats.Controls" AutomationProperties.Name="Year in Reading page">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,22,26,28" MaxWidth="1320"><DockPanel Margin="0,0,0,16"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="‹" Command="{Binding PreviousYearCommand}" Width="34" Padding="0" ToolTip="Previous year" AutomationProperties.Name="Previous year"/><TextBlock Text="{Binding Year}" FontSize="20" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/><Button Content="›" Command="{Binding NextYearCommand}" Width="34" Padding="0" ToolTip="Next year" AutomationProperties.Name="Next year"/></StackPanel><TextBlock Text="YOUR YEAR IN READING" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/></DockPanel>
    <UniformGrid Columns="5" Margin="0,0,0,16"><charts:StatCard Label="TOTAL READING" Value="{Binding YearSummary.TotalSeconds,Converter={StaticResource Duration}}" Detail="Full year"/><charts:StatCard Label="ACTIVE DAYS" Value="{Binding YearSummary.ActiveDays}" Detail="Days with activity"/><charts:StatCard Label="SESSIONS" Value="{Binding YearSummary.Sessions}" Detail="Reconstructed"/><charts:StatCard Label="ACTIVE BOOKS" Value="{Binding YearSummary.ActiveBooks}" Detail="Titles with activity"/><charts:StatCard Label="LONGEST STREAK" Value="{Binding YearLongestStreakLabel}" Detail="Within selected year"/></UniformGrid>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YEARLY BOOK GOAL" Style="{StaticResource Eyebrow}"/><TextBlock FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"><Run Text="{Binding YearBookGoal.BooksRead}"/><Run Text=" / "/><Run Text="{Binding YearBookGoal.TargetBooks,StringFormat={}{0:0.#}}"/><Run Text=" books"/></TextBlock></StackPanel><StackPanel Grid.Column="1" Margin="20,2"><ProgressBar Value="{Binding YearBookGoal.ProgressPercent}" Maximum="100" Margin="0,5,0,7"/><TextBlock Text="{Binding YearBookGoal.Detail}" Style="{StaticResource Muted}"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding YearBookGoal.ProgressPercent,StringFormat={}{0:0.#}%}" FontSize="18" FontWeight="SemiBold" TextAlignment="Right"/><TextBlock Text="{Binding YearBookGoal.Status}" Style="{StaticResource Muted}" TextAlignment="Right" Margin="0,3,0,0"/></StackPanel></Grid></Border>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource ChartCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="12-month reading time" Style="{StaticResource SectionTitle}"/><charts:BarChart ItemsSource="{Binding YearMonths}" Height="225" MaxBarWidth="34"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="HIGHLIGHTS" Style="{StaticResource Eyebrow}"/><TextBlock Text="BEST MONTH" Style="{StaticResource Eyebrow}" Margin="0,14,0,3"/><TextBlock Text="{Binding YearBestMonth}" FontSize="16"/><TextBlock Text="BEST DAY" Style="{StaticResource Eyebrow}" Margin="0,14,0,3"/><TextBlock Text="{Binding YearBestDay}" FontSize="16"/><TextBlock Text="TOP BOOK" Style="{StaticResource Eyebrow}" Margin="0,14,0,3"/><TextBlock Text="{Binding YearTopBook}" FontSize="16" TextWrapping="Wrap"/><TextBlock Text="FAVORITE HOUR" Style="{StaticResource Eyebrow}" Margin="0,14,0,3"/><TextBlock Text="{Binding YearFavoriteHour}"/><TextBlock Text="FAVORITE WEEKDAY" Style="{StaticResource Eyebrow}" Margin="0,14,0,3"/><TextBlock Text="{Binding YearSummary.FavoriteWeekday.Label}"/></StackPanel></Border></Grid>
    <Border Style="{StaticResource ChartCard}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Annual heatmap" Style="{StaticResource SectionTitle}"/><charts:HeatmapChart ItemsSource="{Binding YearHeatmap}" Height="142"/></StackPanel></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Top books" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding YearTopBooks}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Authors}" Style="{StaticResource Muted}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Seconds,Converter={StaticResource Duration}}" VerticalAlignment="Center" TextAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Monthly reading table" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding YearMonths}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}"/><TextBlock Grid.Column="1" Text="{Binding Detail}" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Grid>
  </StackPanel></ScrollViewer>
</UserControl>
