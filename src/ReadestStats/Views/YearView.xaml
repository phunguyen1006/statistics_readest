<UserControl x:Class="ReadestStats.Views.YearView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:ReadestStats.Controls" AutomationProperties.Name="Year in Reading page">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,22,26,28" MaxWidth="1320"><DockPanel Margin="0,0,0,16"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="‹" Command="{Binding PreviousYearCommand}" Width="34" Padding="0" ToolTip="Previous year" AutomationProperties.Name="Previous year"/><TextBlock Text="{Binding Year}" FontSize="20" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/><Button Content="›" Command="{Binding NextYearCommand}" Width="34" Padding="0" ToolTip="Next year" AutomationProperties.Name="Next year"/></StackPanel><TextBlock Text="YOUR YEAR IN READING" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/></DockPanel>
    <UniformGrid Columns="5" Margin="0,0,0,16"><charts:StatCard Label="TOTAL READING" Value="{Binding YearSummary.TotalSeconds,Converter={StaticResource Duration}}" Detail="Full year"/><charts:StatCard Label="ACTIVE DAYS" Value="{Binding YearSummary.ActiveDays}" Detail="Days with activity"/><charts:StatCard Label="SESSIONS" Value="{Binding YearSummary.Sessions}" Detail="Reconstructed"/><charts:StatCard Label="ACTIVE BOOKS" Value="{Binding YearSummary.ActiveBooks}" Detail="Titles with activity"/><charts:StatCard Label="LONGEST STREAK" Value="{Binding YearLongestStreakLabel}" Detail="Within selected year"/></UniformGrid>
    <Border Style="{StaticResource EditorialSection}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YEARLY BOOK GOAL" Style="{StaticResource Eyebrow}"/><TextBlock FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"><Run Text="{Binding YearBookGoal.BooksRead,Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding YearBookGoal.TargetBooks,Mode=OneWay,StringFormat={}{0:0.#}}"/><Run Text=" books"/></TextBlock></StackPanel><StackPanel Grid.Column="1" Margin="20,2"><ProgressBar Value="{Binding YearBookGoal.ProgressPercent,Mode=OneWay}" Maximum="100" Margin="0,5,0,7"/><TextBlock Text="{Binding YearBookGoal.Detail}" Style="{StaticResource Muted}"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding YearBookGoal.ProgressPercent,StringFormat={}{0:0.#}%}" FontSize="18" FontWeight="SemiBold" TextAlignment="Right"/><TextBlock Text="{Binding YearBookGoal.Status}" Style="{StaticResource Muted}" TextAlignment="Right" Margin="0,3,0,0"/></StackPanel></Grid></Border>
    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,0,0,18" Margin="0,0,0,18"><StackPanel><TextBlock Text="YEAR READING STRIP" Style="{StaticResource Eyebrow}"/><TextBlock Text="One mark per day · a compact signature of the year" Style="{StaticResource Muted}" Margin="0,3,0,4"/><charts:FingerprintChart ItemsSource="{Binding YearHeatmap}" Height="70" AutomationProperties.Name="Year reading fingerprint"/></StackPanel></Border>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,26,0"><TextBlock Text="12 MONTHS AT A GLANCE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Monthly reading volume as compact lollipop glyphs" Style="{StaticResource Muted}" Margin="0,3,0,4"/><charts:MonthlyGlyphChart ItemsSource="{Binding YearMonths}" Height="174" AutomationProperties.Name="Twelve monthly reading glyphs"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="BEST READING DAYS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Observed active days ranked with exact duration" Style="{StaticResource Muted}" Margin="0,3,0,4"/><charts:LollipopChart ItemsSource="{Binding BestReadingDays}" Height="174" AutomationProperties.Name="Best reading days lollipop ranking"/></StackPanel></Grid>
    <Border Style="{StaticResource EditorialSection}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Annual heatmap" Style="{StaticResource SectionTitle}"/><charts:HeatmapChart ItemsSource="{Binding YearHeatmap}" Height="142"/></StackPanel></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,26,0"><TextBlock Text="BOOK ATTENTION COMPOSITION" Style="{StaticResource Eyebrow}"/><TextBlock Text="Where the year's reading time was concentrated" Style="{StaticResource Muted}" Margin="0,3,0,4"/><charts:SegmentedBandChart ItemsSource="{Binding YearBookAttention}" Height="86" AutomationProperties.Name="Yearly book attention composition"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="YEAR HIGHLIGHTS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding YearTopBook}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,2"/><TextBlock Text="{Binding YearBestMonth}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0"><Run Text="{Binding YearFavoriteHour,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding YearSummary.FavoriteWeekday.Label,Mode=OneWay}"/></TextBlock></StackPanel></Grid>
  </StackPanel></ScrollViewer>
</UserControl>
