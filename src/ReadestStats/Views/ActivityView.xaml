<UserControl x:Class="ReadestStats.Views.ActivityView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:ReadestStats.Controls" AutomationProperties.Name="Activity page">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,22,26,28" MaxWidth="1480">
    <Border Style="{StaticResource EditorialSection}" Margin="0,0,0,16"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="‹" Command="{Binding PreviousMonthCommand}" Width="34" Padding="0" ToolTip="Previous month"/><TextBlock Text="{Binding MonthLabel}" FontSize="20" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/><Button Content="›" Command="{Binding NextMonthCommand}" Width="34" Padding="0" ToolTip="Next month"/></StackPanel><Button Grid.Column="1" Content="Today" Command="{Binding TodayCommand}"/></Grid><TextBlock Text="{Binding MonthSummary}" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource EditorialSection}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Rolling reading momentum" Style="{StaticResource SectionTitle}"/><TextBlock Text="7-day rolling average; 3-day when the visible range is shorter" Style="{StaticResource Muted}" Margin="0,-7,0,4"/><charts:MomentumChart ItemsSource="{Binding RollingMomentum}" Height="126" AutomationProperties.Name="Rolling reading momentum" AutomationProperties.HelpText="The line shows a transparent rolling average of observed daily reading time."/></StackPanel></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource EditorialSection}" Margin="0,0,20,0"><StackPanel><TextBlock Text="Month calendar" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding WeekdayHeaders}" Margin="0,0,0,6"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Eyebrow}" TextAlignment="Center"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding CalendarDays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectDayCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" BorderBrush="{DynamicResource Border}" Margin="2" Padding="7" Height="70" Opacity="{Binding IsInMonth,Converter={StaticResource BoolOpacity}}" ToolTip="{Binding Date}" AutomationProperties.Name="{Binding Date}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CalendarCellButton}"><Setter Property="Background" Value="{DynamicResource Heatmap0}"/><Setter Property="Foreground" Value="{DynamicResource HeatmapText0}"/><Style.Triggers><DataTrigger Binding="{Binding Intensity}" Value="Low"><Setter Property="Background" Value="{DynamicResource Heatmap1}"/><Setter Property="Foreground" Value="{DynamicResource HeatmapText1}"/></DataTrigger><DataTrigger Binding="{Binding Intensity}" Value="Medium"><Setter Property="Background" Value="{DynamicResource Heatmap2}"/><Setter Property="Foreground" Value="{DynamicResource HeatmapText2}"/></DataTrigger><DataTrigger Binding="{Binding Intensity}" Value="High"><Setter Property="Background" Value="{DynamicResource Heatmap3}"/><Setter Property="Foreground" Value="{DynamicResource HeatmapText3}"/></DataTrigger><DataTrigger Binding="{Binding Intensity}" Value="Peak"><Setter Property="Background" Value="{DynamicResource Heatmap4}"/><Setter Property="Foreground" Value="{DynamicResource HeatmapText4}"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid><TextBlock Text="{Binding Date.Day}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Left" VerticalAlignment="Top"/><charts:SessionGlyphs Count="{Binding Sessions,Mode=OneWay}" Width="26" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"/><TextBlock Text="{Binding DurationLabel}" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource EditorialAside}" Margin="0"><StackPanel><TextBlock Text="{Binding SelectedDay.Date,StringFormat={}{0:MMMM d, yyyy}}" FontSize="18" FontWeight="SemiBold"/><UniformGrid Columns="3" Margin="0,14,0,12"><StackPanel><TextBlock Text="READING" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedDay.Seconds,Converter={StaticResource Duration}}" FontSize="18" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="SESSIONS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedDay.Sessions}" FontSize="18" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="BOOKS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedDay.Books}" FontSize="18" FontWeight="SemiBold"/></StackPanel></UniformGrid><TextBlock Text="24-HOUR SESSION TIMELINE" Style="{StaticResource Eyebrow}" Margin="0,5,0,3"/><charts:TimelineBandChart ItemsSource="{Binding DayTimeline}" Height="122" AutomationProperties.Name="Selected day session timeline" AutomationProperties.HelpText="Each segment is positioned at its actual start and end time; hover for book and activity-event details."/><TextBlock Text="Books" Style="{StaticResource Eyebrow}" Margin="0,14,0,5"/><ItemsControl ItemsSource="{Binding DayBooks}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><TextBlock Text="{Binding Detail}" DockPanel.Dock="Right" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </Grid>
  </StackPanel></ScrollViewer>
</UserControl>
