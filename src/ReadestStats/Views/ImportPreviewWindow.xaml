<Window x:Class="ReadestStats.Views.ImportPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Import Center" Width="900" Height="620" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="IMPORT CENTER" Style="{StaticResource Eyebrow}"/><TextBlock Text="Review books before adding them" Style="{StaticResource PageTitle}" Margin="0,4,0,0"/><TextBlock Text="Nothing is written until you confirm this preview." Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,18,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SOURCE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Provider}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="VALID BOOKS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ValidBooks}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="SKIPPED ROWS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SkippedRows}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Grid>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Books}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="AUTHOR" Binding="{Binding Authors}" Width="1.4*"/><DataGridTextColumn Header="ISBN-13" Binding="{Binding Isbn13}" Width="130"/><DataGridTextColumn Header="PAGES" Binding="{Binding Pages}" Width="80"/><DataGridTextColumn Header="FINISHED" Binding="{Binding FinishedAtUtc,StringFormat={}{0:MMM d, yyyy}}" Width="120"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/><Button Content="Import books" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/></StackPanel>
  </Grid>
</Window>
