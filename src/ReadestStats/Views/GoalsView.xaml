<UserControl x:Class="ReadestStats.Views.GoalsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:ReadestStats.Controls" AutomationProperties.Name="Goals page">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="26,22,26,28" MaxWidth="1200">
      <DockPanel Margin="0,0,0,16"><Button Content="Save goals" Command="{Binding SaveGoalsCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="READING GOALS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Daily reading time and book goals for longer periods." Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></DockPanel>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,28,0"><TextBlock Text="THIS YEAR" Style="{StaticResource Eyebrow}"/><TextBlock FontSize="28" FontWeight="SemiBold" Margin="0,5,0,2"><Run Text="{Binding CurrentYearBookGoal.BooksRead}"/><Run Text=" books"/></TextBlock><TextBlock Text="{Binding CurrentYearBookGoal.Detail}" Style="{StaticResource Muted}"/></StackPanel><StackPanel Grid.Column="1"><DockPanel><TextBlock Text="{Binding CurrentYearBookGoal.ProgressPercent,StringFormat={}{0:0.#}%}" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock><Run Text="Year goal · "/><Run Text="{Binding CurrentYearBookGoal.TargetBooks,StringFormat={}{0:0.#} books}"/></TextBlock></DockPanel><ProgressBar Value="{Binding CurrentYearBookGoal.ProgressPercent}" Maximum="100" Margin="0,10,0,8"/><TextBlock Text="{Binding CurrentYearBookGoal.Status}" Foreground="{DynamicResource TextSecondary}"/></StackPanel></Grid></Border>
      <ItemsControl ItemsSource="{Binding Goals}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,22,0"><DockPanel><CheckBox IsChecked="{Binding Enabled}" DockPanel.Dock="Right" ToolTip="Enable this goal"/><StackPanel><TextBlock Text="{Binding Period}" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding MetricLabel}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></DockPanel><TextBlock Text="Target" Style="{StaticResource Muted}" Margin="0,15,0,5"/><TextBox Text="{Binding TargetAmount,UpdateSourceTrigger=LostFocus}" ToolTip="Goal target" AutomationProperties.Name="Goal target"/><TextBlock Text="{Binding Unit}" Style="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,22,0"><DockPanel><TextBlock Text="{Binding Progress.ProgressPercent,StringFormat={}{0:0.#}%}" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock><Run Text="{Binding Progress.CurrentLabel}"/><Run Text=" / "/><Run Text="{Binding Progress.TargetLabel}"/></TextBlock></DockPanel><ProgressBar Value="{Binding Progress.ProgressPercent}" Maximum="100" Margin="0,10,0,9"/><DockPanel><TextBlock Text="{Binding Progress.Status}" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding Progress.RemainingLabel,StringFormat={}{0} remaining}" Style="{StaticResource Muted}"/></DockPanel><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ELAPSED" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Progress.ElapsedPercent,StringFormat={}{0:0.#}%}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="REQUIRED" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Progress.PaceLabel}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="PROJECTED" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Progress.ProjectionLabel}"/></StackPanel></Grid></StackPanel>
        <StackPanel Grid.Column="2"><DockPanel><TextBlock Text="{Binding History.HitRate,StringFormat={}{0:0}% hit rate}" DockPanel.Dock="Right"/><TextBlock Text="GOAL HISTORY" Style="{StaticResource Eyebrow}"/></DockPanel><charts:BarChart ItemsSource="{Binding History.Points}" Height="108" MaxBarWidth="9" Margin="0,5,0,0"/><TextBlock Style="{StaticResource Muted}"><Run Text="{Binding History.Hit}"/><Run Text=" / "/><Run Text="{Binding History.Total}"/><Run Text=" periods · best streak "/><Run Text="{Binding History.BestStreak}"/></TextBlock></StackPanel>
      </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="PREVIOUS YEARS" Style="{StaticResource Eyebrow}" Margin="0,8,0,8"/>
      <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><ItemsControl ItemsSource="{Binding GoalArchives}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Year}" FontSize="16" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Margin="8,0,22,0"><TextBlock Text="{Binding ResultLabel}"/><ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Margin="0,7,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Status}" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Past years appear here automatically when reading activity exists." Style="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><TextBlock Text="Book goals count unique titles with at least one recorded reading event in the period. Readest's statistics database does not reliably identify completed books, so this app does not claim completion." Style="{StaticResource Muted}"/></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
