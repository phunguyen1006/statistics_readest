<Window x:Class="ReadestStats.Views.SessionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual reading session" Width="520" Height="640" MinWidth="480" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Surface}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock x:Name="Heading" Text="Add a past session" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="Log physical reading that happened without the timer." Style="{StaticResource Muted}" Margin="0,4,0,20"/>
      <TextBlock Text="BOOK" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
      <ComboBox x:Name="BookInput" DisplayMemberPath="Title" AutomationProperties.Name="Physical book"/>
      <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="DATE" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/><DatePicker x:Name="DateInput"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="START TIME" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/><TextBox x:Name="TimeInput" ToolTip="For example 19:30"/></StackPanel>
      </Grid>
      <TextBlock Text="DURATION (MINUTES)" Style="{StaticResource Eyebrow}" Margin="0,14,0,6"/><TextBox x:Name="DurationInput"/>
      <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="START PAGE" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/><TextBox x:Name="StartPageInput"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="LAST PAGE REACHED" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/><TextBox x:Name="EndPageInput"/></StackPanel>
      </Grid>
      <TextBlock Text="NOTE (OPTIONAL)" Style="{StaticResource Eyebrow}" Margin="0,14,0,6"/><TextBox x:Name="NoteInput" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap"/>
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="Save session" Click="Save_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
