<Window x:Class="ReadestStats.Views.SessionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:ReadestStats.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Loc Key=sB32151B6A05946B1}" Width="520" Height="640" MinWidth="480" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Surface}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock x:Name="Heading" Text="{loc:Loc Key=sC66DD88996C8057E}" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="{loc:Loc Key=s1671FC8792BB4673}" Style="{StaticResource Muted}" Margin="0,4,0,20"/>
      <TextBlock Text="{loc:Loc Key=s92719FE0CF8CD515}" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
      <ComboBox x:Name="BookInput" AutomationProperties.Name="{loc:Loc Key=s180952E41B869418}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{loc:Loc Key=s0E87632CD46BD490}" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/><DatePicker x:Name="DateInput"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="{loc:Loc Key=s59DD27A0DDED6429}" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/><TextBox x:Name="TimeInput" ToolTip="{loc:Loc Key=sA2FBDD4D4959A70B}"/></StackPanel>
      </Grid>
      <TextBlock Text="{loc:Loc Key=s61C5569720C82B6F}" Style="{StaticResource Eyebrow}" Margin="0,14,0,6"/><TextBox x:Name="DurationInput"/>
      <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{loc:Loc Key=sFB63090493C8E1F2}" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/><TextBox x:Name="StartPageInput"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="{loc:Loc Key=s4DD39E134B186C6D}" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/><TextBox x:Name="EndPageInput"/></StackPanel>
      </Grid>
      <TextBlock Text="{loc:Loc Key=s440809333C64C6B4}" Style="{StaticResource Eyebrow}" Margin="0,14,0,6"/><TextBox x:Name="NoteInput" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap"/>
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="{loc:Loc Key=s2374D91794B79F4F}" IsCancel="True" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="{loc:Loc Key=s782FD8D965E53C77}" Click="Save_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
