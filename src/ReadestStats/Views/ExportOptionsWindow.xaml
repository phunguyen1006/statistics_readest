<Window x:Class="ReadestStats.Views.ExportOptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="{Binding Heading}" Width="600" Height="470" MinWidth="540" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Border Background="{DynamicResource AppBackground}" Padding="26"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,20"/>
      <TextBlock Text="{Binding ScopeLabel}" Style="{StaticResource Eyebrow}"/>
      <CheckBox IsChecked="{Binding AllItems}" IsEnabled="{Binding IsSharing}" Margin="0,10,0,8" AutomationProperties.Name="{Binding AllItemsLabel}"><TextBlock Text="{Binding AllItemsLabel}" TextWrapping="Wrap"/></CheckBox>
      <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock Text="{Binding EmptyHint}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
      <Separator Background="{DynamicResource Border}" Margin="0,18"/>
      <CheckBox IsChecked="{Binding IncludePrivate}" IsEnabled="{Binding IsSharing}" Margin="0,0,0,12" AutomationProperties.Name="{Binding PrivateLabel}"><TextBlock Text="{Binding PrivateLabel}" TextWrapping="Wrap"/></CheckBox>
      <CheckBox IsChecked="{Binding ArchiveMode}" Visibility="{Binding AllowArchive,Converter={StaticResource BoolVis}}" Margin="0,0,0,10" AutomationProperties.Name="{Binding ArchiveLabel}"><TextBlock Text="{Binding ArchiveLabel}" TextWrapping="Wrap"/></CheckBox>
      <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{Binding CancelLabel}" IsCancel="True" Margin="0,0,8,0"/>
      <Button Content="{Binding ExportLabel}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanExport}" IsDefault="True" Click="Export_Click" AutomationProperties.Name="{Binding ExportLabel}"/>
    </StackPanel>
  </Grid></Border>
</Window>
