<UserControl x:Class="ReadestStats.Views.DataQualityView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.Name="Data quality page">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="26,22,26,28">
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="DATA QUALITY SCORE" Style="{StaticResource Eyebrow}"/><StackPanel Orientation="Horizontal" Margin="0,7,0,5"><TextBlock Text="{Binding DataQuality.Score}" FontSize="32" FontWeight="SemiBold"/><TextBlock Text=" / 100" FontSize="18" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Bottom" Margin="3,0,0,4"/></StackPanel><TextBlock Text="{Binding DataQuality.Status}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding DataQuality.Summary}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Width="220" Margin="24,0,0,0"><TextBlock Text="CHECKS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding DataQuality.PassedChecks,StringFormat={}{0} passed}" Margin="0,7,0,3"/><TextBlock Text="{Binding DataQuality.AttentionChecks,StringFormat={}{0} need attention}"/><Button Content="Run checks again" Command="{Binding RefreshCommand}" Margin="0,12,0,0" HorizontalAlignment="Stretch"/></StackPanel>
        </Grid>
      </Border>
      <TextBlock Text="QUALITY CHECKS" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
      <ItemsControl ItemsSource="{Binding DataQualityChecks}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,12,12" MinHeight="128"><StackPanel><DockPanel><Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceAlt}" CornerRadius="12" Padding="9,4"><TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,10,0,6"/><TextBlock Text="{Binding Evidence}" Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Readest Stats only analyzes the source. These checks never modify the Readest database or library." Style="{StaticResource Muted}" Margin="0,2,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
