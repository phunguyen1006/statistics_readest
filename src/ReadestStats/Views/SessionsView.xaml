<UserControl x:Class="ReadestStats.Views.SessionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:ReadestStats.Controls" AutomationProperties.Name="Sessions page">
  <Grid Margin="26,22,26,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <UniformGrid Columns="6" Margin="0,0,0,16"><charts:StatCard Label="TOTAL SESSIONS" Value="{Binding Period.SessionCount}" Detail="Selected period"/><charts:StatCard Label="AVERAGE" Value="{Binding SessionProfile.Average,Converter={StaticResource Duration}}" Detail="Active reading"/><charts:StatCard Label="MEDIAN" Value="{Binding SessionProfile.Median,Converter={StaticResource Duration}}" Detail="Typical session"/><charts:StatCard Label="LONGEST" Value="{Binding SessionProfile.Longest,Converter={StaticResource Duration}}" Detail="Active reading"/><charts:StatCard Label="ACTIVE TIME" Value="{Binding Period.TotalSeconds,Converter={StaticResource Duration}}" Detail="Not elapsed span"/><charts:StatCard Label="SESSIONS / DAY" Value="{Binding SessionsPerActiveDay,StringFormat={}{0:0.#}}" Detail="Per active day"/></UniformGrid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding SessionBookOptions}" SelectedItem="{Binding SessionBook}"/><ComboBox Grid.Column="1" ItemsSource="{Binding SessionDurations}" SelectedItem="{Binding SessionDuration}" Margin="8,0"/><TextBox Grid.Column="2" Text="{Binding SessionSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search session book title" ToolTip="Search book title"/><ComboBox Grid.Column="3" ItemsSource="{Binding SessionSorts}" SelectedItem="{Binding SessionSort}" Margin="8,0,0,0"/></Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" AutoGenerateColumns="False" IsReadOnly="True" CellStyle="{StaticResource CenteredDataGridCell}" ColumnHeaderStyle="{StaticResource CenteredDataGridHeader}"><DataGrid.Columns><DataGridTextColumn Header="START" Width="88"><DataGridTextColumn.Binding><MultiBinding Converter="{StaticResource Clock}"><Binding Path="Start"/><Binding Path="DataContext.Use24HourTime" RelativeSource="{RelativeSource AncestorType=DataGrid}"/></MultiBinding></DataGridTextColumn.Binding></DataGridTextColumn><DataGridTextColumn Header="END" Width="88"><DataGridTextColumn.Binding><MultiBinding Converter="{StaticResource Clock}"><Binding Path="End"/><Binding Path="DataContext.Use24HourTime" RelativeSource="{RelativeSource AncestorType=DataGrid}"/></MultiBinding></DataGridTextColumn.Binding></DataGridTextColumn><DataGridTextColumn Header="ACTIVE TIME" Binding="{Binding DurationSeconds,Converter={StaticResource Duration}}" Width="110"/><DataGridTemplateColumn Header="BOOK" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Books}" Command="{Binding DataContext.OpenSessionBookCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Open this title in Books" Style="{StaticResource TextLinkButton}" HorizontalAlignment="Stretch"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="ACTIVITY EVENTS" Binding="{Binding EventCount}" Width="120"/><DataGridTextColumn Header="DATE" Binding="{Binding Start,StringFormat={}{0:MMM d, yyyy}}" Width="120"/></DataGrid.Columns></DataGrid>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="SESSION" Style="{StaticResource Eyebrow}"/><TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,5,0,16"><TextBlock.Text><MultiBinding Converter="{StaticResource Clock}" ConverterParameter="date-time"><Binding Path="SelectedSession.Start"/><Binding Path="Use24HourTime"/></MultiBinding></TextBlock.Text></TextBlock><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ACTIVE READING" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedSession.DurationSeconds,Converter={StaticResource Duration}}" FontSize="22" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ELAPSED SPAN" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedSession.ElapsedSeconds,Converter={StaticResource Duration}}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Grid><Separator Background="{DynamicResource Border}" Margin="0,16"/><TextBlock Text="BOOK" Style="{StaticResource Eyebrow}"/><Button Content="{Binding SelectedSession.Books}" Command="{Binding OpenSessionBookCommand}" CommandParameter="{Binding SelectedSession}" Style="{StaticResource TextLinkButton}" HorizontalContentAlignment="Left" Margin="-6,4,0,12" ToolTip="Open this title in Books"/><TextBlock Text="ACTIVITY EVENTS" Style="{StaticResource Eyebrow}" ToolTip="Reader page/progress events; this is not necessarily the number of physical pages read."/><TextBlock Text="{Binding SelectedSession.EventCount}" Margin="0,4,0,16"/><TextBlock Text="Activity density" Style="{StaticResource SectionTitle}"/><charts:BarChart ItemsSource="{Binding SessionTimeline}" Height="150" MaxBarWidth="12"/></StackPanel></ScrollViewer></Border>
    </Grid>
  </Grid>
</UserControl>
