<UserControl x:Class="ReadestStats.Views.BooksView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:ReadestStats.Controls" AutomationProperties.Name="Books page">
  <UserControl.Resources>
    <Style x:Key="LibraryBookItem" TargetType="ListBoxItem">
      <Setter Property="Width" Value="158"/><Setter Property="MinHeight" Value="252"/><Setter Property="Margin" Value="0,0,12,16"/><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SurfaceHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SurfaceActive}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter TargetName="Tile" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Grid Margin="26,22,26,26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
      <TextBox Text="{Binding BookSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search title or author" AutomationProperties.Name="Search books"/>
      <ComboBox Grid.Column="1" ItemsSource="{Binding BookFilters}" SelectedItem="{Binding BookFilter}" Margin="8,0" AutomationProperties.Name="Filter books"/>
      <ComboBox Grid.Column="2" ItemsSource="{Binding BookSorts}" SelectedItem="{Binding BookSort}" AutomationProperties.Name="Sort books"/>
    </Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource LibraryBookItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Book library">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate><StackPanel>
          <Border Width="140" Height="198" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
            <Grid><Image Source="/ReadestStats;component/Assets/readest-book.png" Width="54" Height="54" Stretch="Uniform" Opacity="0.42" AutomationProperties.Name="No cover available"/><Image Source="{Binding CoverPath,Converter={StaticResource CoverImage},ConverterParameter=280}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Title}"/></Grid>
          </Border>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" Margin="1,8,1,0" ToolTip="{Binding Title}"/>
          <TextBlock Text="{Binding Authors}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="1,2,1,0" ToolTip="{Binding Authors}"/>
          <TextBlock Text="{Binding Seconds,Converter={StaticResource Duration}}" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="1,5,1,0"/>
        </StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Width="80" Height="114" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" ClipToBounds="True" VerticalAlignment="Top"><Grid><Image Source="/ReadestStats;component/Assets/readest-book.png" Width="36" Height="36" Opacity="0.42"/><Image Source="{Binding SelectedBook.CoverPath,Converter={StaticResource CoverImage},ConverterParameter=160}" Stretch="UniformToFill"/></Grid></Border>
            <StackPanel Grid.Column="1"><TextBlock Text="{Binding SelectedBook.Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedBook.Authors}" Style="{StaticResource Muted}" Margin="0,3,0,10"/><TextBlock Text="{Binding SelectedBook.Status}" Foreground="{DynamicResource TextSecondary}"/></StackPanel>
          </Grid>
          <WrapPanel>
            <Button Content="Open in Readest" Command="{Binding OpenBookInReadestCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" AutomationProperties.Name="Open selected book in Readest"/>
            <ComboBox ItemsSource="{Binding BookStatusOptions}" SelectedItem="{Binding SelectedBookStatus}" Width="142" Margin="0,0,8,8" AutomationProperties.Name="Reading status"/>
            <Button Content="{Binding PinBookLabel}" Command="{Binding TogglePinnedBookCommand}" Margin="0,0,0,8" AutomationProperties.Name="Pin or unpin selected book"/>
          </WrapPanel>
          <TextBlock Text="{Binding OpenBookStatus}" TextWrapping="Wrap" Margin="0,0,0,12"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <UniformGrid Columns="2">
            <StackPanel Margin="0,0,8,12"><TextBlock Text="TOTAL READING" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedBook.Seconds,Converter={StaticResource Duration}}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            <StackPanel Margin="8,0,0,12"><TextBlock Text="ACTIVE DAYS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedBook.ActiveDays}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            <StackPanel Margin="0,0,8,12"><TextBlock Text="SESSIONS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedBook.Sessions}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            <StackPanel Margin="8,0,0,12"><TextBlock Text="AVG SESSION" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedBook.AverageSessionSeconds,Converter={StaticResource Duration}}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            <StackPanel Margin="0,0,8,12"><TextBlock Text="FIRST READ" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BookDetail.Summary.FirstRead,StringFormat={}{0:MMM d, yyyy}}"/></StackPanel>
            <StackPanel Margin="8,0,0,12"><TextBlock Text="LAST READ" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BookDetail.Summary.LastRead,StringFormat={}{0:MMM d, yyyy}}"/></StackPanel>
          </UniformGrid>
          <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="10" Margin="0,0,0,14"><WrapPanel><TextBlock Text="{Binding BookDetail.CurrentStreak,StringFormat=Current {0}d}"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding BookDetail.LongestStreak,StringFormat=Best {0}d}"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding SelectedBook.Share,StringFormat={}{0:P0} share}"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding SelectedBook.TypicalHour,StringFormat=Typical {0}}"/></WrapPanel></Border>
          <TextBlock Text="Daily reading" Style="{StaticResource SectionTitle}"/><charts:BarChart ItemsSource="{Binding BookTrend}" Height="150" MaxBarWidth="12"/>
          <TextBlock Text="Time of day" Style="{StaticResource SectionTitle}" Margin="0,14,0,0"/><charts:BarChart ItemsSource="{Binding BookHourly}" Height="130" MaxBarWidth="10"/>
          <TextBlock Text="Day of week" Style="{StaticResource SectionTitle}" Margin="0,14,0,0"/><charts:BarChart ItemsSource="{Binding BookWeekdays}" Height="130" MaxBarWidth="22"/>
          <TextBlock Text="Recent sessions" Style="{StaticResource SectionTitle}" Margin="0,14,0,0"/>
          <ItemsControl ItemsSource="{Binding BookSessions}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><TextBlock Text="{Binding DurationSeconds,Converter={StaticResource Duration}}" DockPanel.Dock="Right" Style="{StaticResource Muted}"/><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource Clock}" ConverterParameter="short-date-time"><Binding Path="Start"/><Binding Path="DataContext.Use24HourTime" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text></TextBlock></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
