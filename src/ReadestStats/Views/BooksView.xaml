<UserControl x:Class="ReadestStats.Views.BooksView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:ReadestStats.Controls" AutomationProperties.Name="Books page">
  <Grid Margin="26,22,26,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBox Text="{Binding BookSearch,UpdateSourceTrigger=PropertyChanged}" ToolTip="Search title or author" AutomationProperties.Name="Search books"/><ComboBox Grid.Column="1" ItemsSource="{Binding BookFilters}" SelectedItem="{Binding BookFilter}" Margin="8,0"/><ComboBox Grid.Column="2" ItemsSource="{Binding BookSorts}" SelectedItem="{Binding BookSort}"/></Grid></Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <DataGrid ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" AutoGenerateColumns="False" IsReadOnly="True" CellStyle="{StaticResource CenteredDataGridCell}" ColumnHeaderStyle="{StaticResource CenteredDataGridHeader}"><DataGrid.Columns><DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="AUTHOR" Binding="{Binding Authors}" Width="150"/><DataGridTextColumn Header="READING TIME" Binding="{Binding Seconds,Converter={StaticResource Duration}}" Width="105"/><DataGridTextColumn Header="ACTIVE DAYS" Binding="{Binding ActiveDays}" Width="92"/><DataGridTextColumn Header="SESSIONS" Binding="{Binding Sessions}" Width="75"/><DataGridTextColumn Header="LAST READ" Binding="{Binding LastRead,StringFormat={}{0:MMM d}}" Width="80"/><DataGridTextColumn Header="SHARE" Binding="{Binding Share,StringFormat={}{0:P0}}" Width="65"/></DataGrid.Columns></DataGrid>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="{Binding SelectedBook.Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedBook.Authors}" Style="{StaticResource Muted}" Margin="0,3,0,16"/><UniformGrid Columns="2"><StackPanel Margin="0,0,8,12"><TextBlock Text="TOTAL READING" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedBook.Seconds,Converter={StaticResource Duration}}" FontSize="18" FontWeight="SemiBold"/></StackPanel><StackPanel Margin="8,0,0,12"><TextBlock Text="ACTIVE DAYS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedBook.ActiveDays}" FontSize="18" FontWeight="SemiBold"/></StackPanel><StackPanel Margin="0,0,8,12"><TextBlock Text="SESSIONS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedBook.Sessions}" FontSize="18" FontWeight="SemiBold"/></StackPanel><StackPanel Margin="8,0,0,12"><TextBlock Text="AVG SESSION" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedBook.AverageSessionSeconds,Converter={StaticResource Duration}}" FontSize="18" FontWeight="SemiBold"/></StackPanel><StackPanel Margin="0,0,8,12"><TextBlock Text="FIRST READ" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BookDetail.Summary.FirstRead,StringFormat={}{0:MMM d, yyyy}}"/></StackPanel><StackPanel Margin="8,0,0,12"><TextBlock Text="LAST READ" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BookDetail.Summary.LastRead,StringFormat={}{0:MMM d, yyyy}}"/></StackPanel></UniformGrid><Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="10" Margin="0,0,0,14"><WrapPanel><TextBlock Text="{Binding BookDetail.CurrentStreak,StringFormat=Current streak {0}d}"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding BookDetail.LongestStreak,StringFormat=Best {0}d}"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding SelectedBook.Share,StringFormat={}{0:P0} share}"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding SelectedBook.TypicalHour,StringFormat=Typical {0}}"/></WrapPanel></Border><TextBlock Text="Daily reading" Style="{StaticResource SectionTitle}"/><charts:BarChart ItemsSource="{Binding BookTrend}" Height="155" MaxBarWidth="12"/><TextBlock Text="Time of day" Style="{StaticResource SectionTitle}" Margin="0,14,0,0"/><charts:BarChart ItemsSource="{Binding BookHourly}" Height="135" MaxBarWidth="10"/><TextBlock Text="Day of week" Style="{StaticResource SectionTitle}" Margin="0,14,0,0"/><charts:BarChart ItemsSource="{Binding BookWeekdays}" Height="135" MaxBarWidth="22"/><TextBlock Text="Recent sessions" Style="{StaticResource SectionTitle}" Margin="0,14,0,0"/><ItemsControl ItemsSource="{Binding BookSessions}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><TextBlock Text="{Binding DurationSeconds,Converter={StaticResource Duration}}" DockPanel.Dock="Right" Style="{StaticResource Muted}"/><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource Clock}" ConverterParameter="short-date-time"><Binding Path="Start"/><Binding Path="DataContext.Use24HourTime" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text></TextBlock></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Page-based values are hidden by default because pagination and layout can change them." Style="{StaticResource Muted}" Margin="0,14,0,0"/></StackPanel></ScrollViewer></Border>
    </Grid>
  </Grid>
</UserControl>
