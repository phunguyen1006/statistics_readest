<UserControl x:Class="ReadestStats.Views.StatisticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:ReadestStats.Controls" AutomationProperties.Name="Statistics page">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="26,22,26,28" MaxWidth="1480">
      <UniformGrid Columns="6" Margin="0,0,0,16">
        <charts:StatCard Label="READING TIME" Value="{Binding Period.TotalSeconds,Converter={StaticResource Duration}}" Detail="Selected period" Command="{Binding NavigateCommand}" CommandParameter="Activity" Help="Open the daily activity behind this total."/>
        <charts:StatCard Label="READING DAYS" Value="{Binding Period.ActiveDays}" Detail="{Binding Period.ConsistencyPercent,StringFormat={}{0:0}% consistency}" Command="{Binding NavigateCommand}" CommandParameter="Activity" Help="Days with at least one valid positive-duration event."/>
        <charts:StatCard Label="SESSIONS" Value="{Binding Period.SessionCount}" Detail="{Binding SessionProfile.Median,Converter={StaticResource Duration},StringFormat=Median {0}}" Command="{Binding NavigateCommand}" CommandParameter="Sessions" Help="Sessions reconstructed using the configured gap."/>
        <charts:StatCard Label="ACTIVE BOOKS" Value="{Binding Period.ActiveBooks}" Detail="Selected period" Command="{Binding NavigateCommand}" CommandParameter="Books" Help="Books with recorded activity in the selected period."/>
        <charts:StatCard Label="CURRENT STREAK" Value="{Binding CurrentStreakLabel}" Detail="{Binding LongestStreakLabel}" Command="{Binding NavigateCommand}" CommandParameter="Activity" Help="Consecutive local calendar days ending today or yesterday."/>
        <charts:StatCard Label="BOOKS FINISHED" Value="{Binding FinishedInRange}" Detail="Marked Finished" Command="{Binding NavigateCommand}" CommandParameter="Goals" Help="Completion dates stored by Readest Stats inside the selected period."/>
      </UniformGrid>

      <Border Style="{StaticResource ChartCard}" Margin="0,0,0,16"><StackPanel><DockPanel><TextBlock Text="Reading trend" Style="{StaticResource SectionTitle}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox ItemsSource="{Binding TrendMetrics}" SelectedItem="{Binding TrendMetric}" Width="142"/><ComboBox ItemsSource="{Binding Granularities}" SelectedItem="{Binding TrendGranularity}" Width="110" Margin="8,0,0,0"/></StackPanel></DockPanel><TextBlock Text="{Binding TrendSummary}" Style="{StaticResource Muted}" Margin="0,-6,0,8"/><charts:BarChart ItemsSource="{Binding Trend}" Height="220" MaxBarWidth="20"/></StackPanel></Border>

      <Border Style="{StaticResource ChartCard}" Margin="0,0,0,16"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="Current" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><TextBlock Text="{Binding CurrentStreakLabel}" Margin="7,0,18,0" VerticalAlignment="Center"/><TextBlock Text="Best" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><TextBlock Text="{Binding LongestStreak}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Text="365-day activity" Style="{StaticResource SectionTitle}"/></DockPanel><charts:HeatmapChart ItemsSource="{Binding Heatmap}" ItemClickCommand="{Binding SelectHeatmapDayCommand}" Height="142" AutomationProperties.HelpText="Select a day to inspect its reading activity."/></StackPanel></Border>

      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource ChartCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Reading by hour" Style="{StaticResource SectionTitle}"/><charts:BarChart ItemsSource="{Binding Hourly}" Height="190" MaxBarWidth="12"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource ChartCard}" Margin="8,0"><StackPanel><TextBlock Text="Reading by weekday" Style="{StaticResource SectionTitle}"/><charts:BarChart ItemsSource="{Binding Weekdays}" Height="190" MaxBarWidth="28"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource ChartCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Time of day" Style="{StaticResource SectionTitle}"/><charts:BarChart ItemsSource="{Binding TimeBlocks}" Height="190" MaxBarWidth="34"/></StackPanel></Border>
      </Grid>

      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource ChartCard}" Margin="0,0,8,0"><StackPanel><DockPanel><TextBlock Text="Session distribution" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding SessionProfile.Average,Converter={StaticResource Duration},StringFormat=Average {0}}" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel><charts:BarChart ItemsSource="{Binding SessionHistogram}" Height="190" MaxBarWidth="38"/><UniformGrid Columns="4" Margin="0,8,0,0"><StackPanel><TextBlock Text="SHORTEST" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SessionProfile.Shortest,Converter={StaticResource Duration}}"/></StackPanel><StackPanel><TextBlock Text="MEDIAN" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SessionProfile.Median,Converter={StaticResource Duration}}"/></StackPanel><StackPanel><TextBlock Text="LONGEST" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SessionProfile.Longest,Converter={StaticResource Duration}}"/></StackPanel><StackPanel><TextBlock Text="PER ACTIVE DAY" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SessionsPerActiveDay,StringFormat={}{0:0.#}}"/></StackPanel></UniformGrid></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource ChartCard}" Margin="8,0,0,0"><StackPanel><DockPanel><TextBlock Text="Finished books" Style="{StaticResource SectionTitle}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="This year" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><TextBlock Text="{Binding FinishedThisYear}" FontWeight="SemiBold" Margin="7,0,16,0"/><TextBlock Text="All time" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><TextBlock Text="{Binding FinishedAllTime}" FontWeight="SemiBold" Margin="7,0,0,0"/></StackPanel></DockPanel><charts:BarChart ItemsSource="{Binding CompletionTimeline}" Height="190" MaxBarWidth="24"/><DockPanel Margin="0,8,0,0"><TextBlock Text="{Binding CurrentYearBookGoal.Status}" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}"/><TextBlock><Run Text="Year goal · "/><Run Text="{Binding CurrentYearBookGoal.BooksRead}"/><Run Text=" / "/><Run Text="{Binding CurrentYearBookGoal.TargetBooks,StringFormat={}{0:0.#}}"/></TextBlock></DockPanel><ProgressBar Value="{Binding CurrentYearBookGoal.ProgressPercent}" Maximum="100" Margin="0,7,0,0"/></StackPanel></Border>
      </Grid>

      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Top books" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding StatisticsTopBooks}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="76"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Authors}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Seconds,Converter={StaticResource Duration}}" TextAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Sessions,StringFormat={}{0} ses.}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Personal records" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding Records}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceAlt}" CornerRadius="7" Padding="12" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,2"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
