<UserControl x:Class="ReadestStats.Views.StatisticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:ReadestStats.Controls" AutomationProperties.Name="Statistics reading story page">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="26,22,26,32" MaxWidth="1380">
      <Border Visibility="{Binding NoPeriodData,Converter={StaticResource BoolVis}}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,10,0,24" Margin="0,0,0,24">
        <StackPanel><TextBlock Text="Not enough reading history yet" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Read in Readest and refresh to begin your personal reading story." Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
      </Border>
      <Grid Margin="0,0,0,28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,32,0">
          <TextBlock Text="YOUR READING STORY" Style="{StaticResource Eyebrow}"/>
          <TextBlock Text="{Binding Period.TotalSeconds,Converter={StaticResource Duration}}" FontSize="42" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display,Segoe UI" Margin="0,7,0,2"/>
          <TextBlock Text="{Binding ReadingPeriodSummary}" Foreground="{DynamicResource TextSecondary}"/>
          <TextBlock Text="{Binding ComparisonText}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
          <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="ACTIVE DAYS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Period.ActiveDays}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding Period.ConsistencyPercent,StringFormat={}{0:0}% of eligible days}" Style="{StaticResource Muted}"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="CURRENT STREAK" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding CurrentStreakLabel}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Style="{StaticResource Muted}"><Run Text="All history · "/><Run Text="{Binding LongestStreakLabel,Mode=OneWay}"/></TextBlock></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="SESSIONS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Period.SessionCount}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding SessionProfile.Median,Converter={StaticResource Duration},StringFormat=Median {0}}" Style="{StaticResource Muted}"/></StackPanel>
            <StackPanel Grid.Column="3"><TextBlock Text="BOOKS ACTIVE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Period.ActiveBooks}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="{Binding TopBookLabel}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></StackPanel>
          </Grid>
        </StackPanel>
        <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" Padding="26,0,0,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <charts:ProgressRing Value="{Binding CurrentYearBookGoal.ProgressPercent,Mode=OneWay}" Maximum="100" Width="92" Height="92" AutomationProperties.Name="Current yearly book goal progress"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0"><TextBlock Text="YEAR GOAL" Style="{StaticResource Eyebrow}"/><TextBlock FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2"><Run Text="{Binding CurrentYearBookGoal.BooksRead,Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding CurrentYearBookGoal.TargetBooks,Mode=OneWay,StringFormat={}{0:0.#}}"/><Run Text=" books"/></TextBlock><TextBlock Text="{Binding CurrentYearBookGoal.Status}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="Finished dates are stored locally" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
          </Grid>
        </Border>
      </Grid>
      <Separator Background="{DynamicResource Border}" Margin="0,0,0,24"/>
      <DockPanel Margin="0,0,0,12"><TextBlock Text="{Binding Story.StreakContext}" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Bottom"/><StackPanel><TextBlock Text="HOW OFTEN YOU READ" Style="{StaticResource Eyebrow}"/><TextBlock Text="A year of activity, with your current rhythm in focus" Style="{StaticResource SectionTitle}" Margin="0,3,0,0"/></StackPanel></DockPanel>
      <charts:HeatmapChart ItemsSource="{Binding Heatmap}" ItemClickCommand="{Binding SelectHeatmapDayCommand}" Height="140" AutomationProperties.Name="365-day reading activity" AutomationProperties.HelpText="Each square is a local calendar day. Select a day to inspect it in Activity."/>
      <Grid Margin="0,8,0,28"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LAST 30 DAYS" Style="{StaticResource Eyebrow}"/><TextBlock FontSize="18" FontWeight="SemiBold"><Run Text="{Binding Story.ActiveLast30,Mode=OneWay}"/><Run Text=" active"/></TextBlock></StackPanel><charts:StreakStripChart Grid.Column="1" ItemsSource="{Binding StreakTimeline}" Height="52" AutomationProperties.Name="Last 30 days streak timeline" AutomationProperties.HelpText="Filled cells are days with recorded reading activity."/></Grid>
      <Separator Background="{DynamicResource Border}" Margin="0,0,0,24"/>
      <DockPanel Margin="0,0,0,8"><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding PatternMetrics}" SelectedItem="{Binding PatternMetric}" Width="96" AutomationProperties.Name="Week hour matrix metric"/><StackPanel><TextBlock Text="WHEN DURING THE WEEK YOU READ" Style="{StaticResource Eyebrow}"/><TextBlock Text="Week × hour reading matrix" Style="{StaticResource SectionTitle}" Margin="0,3,0,0"/></StackPanel></DockPanel>
      <TextBlock Text="{Binding PatternSummary}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
      <charts:MatrixChart ItemsSource="{Binding WeekHourMatrix}" Height="190" Margin="0,0,0,28" AutomationProperties.Name="Weekday by hour reading matrix" AutomationProperties.HelpText="Rows are Monday through Sunday, columns are hours, and darker cells represent more reading activity. A dot marks multiple sessions."/>
      <Separator Background="{DynamicResource Border}" Margin="0,0,0,24"/>
      <DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox ItemsSource="{Binding TrendMetrics}" SelectedItem="{Binding TrendMetric}" Width="140" AutomationProperties.Name="Trend metric"/><ComboBox ItemsSource="{Binding Granularities}" SelectedItem="{Binding TrendGranularity}" Width="104" Margin="8,0,0,0" AutomationProperties.Name="Trend time grouping"/><ComboBox ItemsSource="{Binding CompareModes}" SelectedItem="{Binding CompareMode}" Width="158" Margin="8,0,0,0" AutomationProperties.Name="Compare trend with"/></StackPanel><StackPanel><TextBlock Text="HOW YOUR READING CHANGES" Style="{StaticResource Eyebrow}"/><TextBlock Text="Selected-period trend and accumulation" Style="{StaticResource SectionTitle}" Margin="0,3,0,0"/><TextBlock Text="{Binding TrendSummary}" Style="{StaticResource Muted}" Margin="0,3,0,0"/><TextBlock Text="{Binding ComparisonLegend}" Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></DockPanel>
      <charts:LineChart ItemsSource="{Binding Trend}" ComparisonItemsSource="{Binding ComparisonTrend}" Height="220" Margin="0,0,0,4" AutomationProperties.Name="Selected-period reading trend" AutomationProperties.HelpText="Solid line is current; dashed line is comparison. Use left and right arrow keys to inspect exact points."/>
      <Expander Header="View exact trend data" Margin="0,0,0,24"><ItemsControl ItemsSource="{Binding Trend}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding Detail}" DockPanel.Dock="Right" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Label}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
      <Grid Margin="0,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,20,0"><TextBlock Text="ROLLING MOMENTUM" Style="{StaticResource Eyebrow}"/><TextBlock Text="A transparent rolling average smooths isolated daily spikes" Style="{StaticResource Muted}" Margin="0,3,0,5"/><charts:MomentumChart ItemsSource="{Binding RollingMomentum}" Height="180" AutomationProperties.Name="Rolling reading momentum"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="SESSION-BY-SESSION ACCUMULATION" Style="{StaticResource Eyebrow}"/><TextBlock Text="Every reconstructed session creates one step" Style="{StaticResource Muted}" Margin="0,3,0,5"/><charts:StaircaseChart ItemsSource="{Binding SessionStaircase}" Height="180" AutomationProperties.Name="Cumulative session staircase"/></StackPanel>
      </Grid>
      <Grid Margin="0,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0"><TextBlock Text="THIS YEAR" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Story.BestMonth}" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,4"/><charts:LineChart ItemsSource="{Binding MonthlyJourney}" Height="185" AutomationProperties.Name="Monthly reading journey this year"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="CURRENT VS PREVIOUS" Style="{StaticResource Eyebrow}"/><TextBlock Text="Previous → current; exact values stay directly labeled" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,8"/><charts:DumbbellChart ItemsSource="{Binding PeriodDumbbells}" Height="142" AutomationProperties.Name="Current versus previous period dumbbells"/><TextBlock Text="{Binding ComparisonText}" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
      </Grid>
      <Separator Background="{DynamicResource Border}" Margin="0,0,0,24"/>
      <TextBlock Text="HOW YOU READ" Style="{StaticResource Eyebrow}"/>
      <TextBlock Text="Session length and the books receiving your time" Style="{StaticResource SectionTitle}" Margin="0,3,0,14"/>
      <Grid Margin="0,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,24,0"><DockPanel><TextBlock Text="SESSION DISTRIBUTION" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SessionProfile.Median,Converter={StaticResource Duration},StringFormat=Median {0}}" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}"/></DockPanel><charts:SessionDistributionChart ItemsSource="{Binding SessionDots}" Height="158" AutomationProperties.Name="Adaptive reading session distribution"/><TextBlock Style="{StaticResource Muted}" Margin="0,5,0,0"><Run Text="Dots at ≤15 sessions · grouped above 15 · middle 50%: "/><Run Text="{Binding SessionProfile.P25,Mode=OneWay,Converter={StaticResource Duration}}"/><Run Text=" – "/><Run Text="{Binding SessionProfile.P75,Mode=OneWay,Converter={StaticResource Duration}}"/></TextBlock></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="TOP BOOKS BY READING TIME" Style="{StaticResource Eyebrow}"/><TextBlock Text="No active books in this period" Style="{StaticResource Muted}" Visibility="{Binding NoPeriodData,Converter={StaticResource BoolVis}}" Margin="0,10,0,0"/><ItemsControl ItemsSource="{Binding StatisticsTopBooks}" AlternationCount="100" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},Path=(ItemsControl.AlternationIndex),Converter={StaticResource OneBasedIndex}}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><ProgressBar Value="{Binding Share,Mode=OneWay}" Maximum="1" Height="3" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Seconds,Converter={StaticResource Duration}}" TextAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
      </Grid>
      <Grid Margin="0,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="READING STYLE MAP" Style="{StaticResource Eyebrow}"/><TextBlock Text="Few or many sessions · short or long sessions" Style="{StaticResource Muted}" Margin="0,3,0,3"/><charts:ScatterPlotChart ItemsSource="{Binding ReadingStyleDays}" Height="165" AutomationProperties.Name="Reading style map by active day"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="BOOK ATTENTION COMPOSITION" Style="{StaticResource Eyebrow}"/><TextBlock Text="How reading time is divided, not merely ranked" Style="{StaticResource Muted}" Margin="0,3,0,4"/><charts:SegmentedBandChart ItemsSource="{Binding BookAttention}" Height="82" AutomationProperties.Name="Book attention composition"/></StackPanel></Grid>
      <Separator Background="{DynamicResource Border}" Margin="0,0,0,24"/>
      <TextBlock Text="PERSONAL RECORDS" Style="{StaticResource Eyebrow}"/>
      <TextBlock Text="Milestones calculated from recorded activity" Style="{StaticResource SectionTitle}" Margin="0,3,0,14"/>
      <ItemsControl ItemsSource="{Binding Records}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,28,14"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="1"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid><Border Grid.Row="1" Background="{DynamicResource Border}" Margin="0,13,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
