<Window x:Class="ReadestStats.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ReadestStats.Views" xmlns:local="clr-namespace:ReadestStats" Title="Readest Stats" Icon="Assets/readest-book.ico" Width="1180" Height="760" MinWidth="1100" MinHeight="650" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.InputBindings>
    <KeyBinding Gesture="Ctrl+R" Command="{Binding RefreshCommand}"/><KeyBinding Gesture="Ctrl+K" Command="{Binding OpenCommandPaletteCommand}"/><KeyBinding Gesture="Escape" Command="{Binding CloseCommandPaletteCommand}"/>
    <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateCommand}" CommandParameter="Today"/><KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateCommand}" CommandParameter="Activity"/><KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateCommand}" CommandParameter="Sessions"/><KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateCommand}" CommandParameter="Books"/><KeyBinding Gesture="Ctrl+5" Command="{Binding NavigateCommand}" CommandParameter="Goals"/><KeyBinding Gesture="Ctrl+6" Command="{Binding NavigateCommand}" CommandParameter="Statistics"/><KeyBinding Gesture="Ctrl+7" Command="{Binding NavigateCommand}" CommandParameter="Year in Reading"/><KeyBinding Gesture="Ctrl+8" Command="{Binding NavigateCommand}" CommandParameter="Settings"/><KeyBinding Gesture="Ctrl+9" Command="{Binding NavigateCommand}" CommandParameter="Notes"/>
    <KeyBinding Gesture="Ctrl+M" Command="{Binding NavigateCommand}" CommandParameter="Manual log"/><KeyBinding Gesture="Ctrl+N" Command="{Binding RandomNoteCommand}"/><KeyBinding Gesture="Ctrl+B" Command="{Binding NavigateCommand}" CommandParameter="Books"/><KeyBinding Gesture="Ctrl+Shift+A" Command="{Binding NavigateCommand}" CommandParameter="Manual log"/><KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding StartSelectedManualSessionCommand}"/>
  </Window.InputBindings>
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVis"/><local:InverseBooleanVisibilityConverter x:Key="InverseBoolVis"/><local:PageVisibilityConverter x:Key="PageVis"/><local:DurationConverter x:Key="Duration"/><local:FileSizeConverter x:Key="FileSize"/><local:PercentChangeConverter x:Key="PercentChange"/><local:BoolOpacityConverter x:Key="BoolOpacity"/><local:IntensityBrushConverter x:Key="IntensityBrush"/><CollectionViewSource x:Key="GroupedNavigation" Source="{Binding Navigation}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group"/></CollectionViewSource.GroupDescriptions></CollectionViewSource></Window.Resources>
  <Grid Background="{DynamicResource AppBackground}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="12,16">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="8,0,0,20"><Image Source="Assets/readest-book.png" Width="30" Height="30" Stretch="Uniform" AutomationProperties.Name="Readest Stats book icon"/><TextBlock Text="Readest Stats" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/></StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Source={StaticResource GroupedNavigation}}" SelectedValuePath="Name" SelectedValue="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItemStyle}" KeyboardNavigation.TabNavigation="Cycle"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Data="{Binding Icon}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox><TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
        <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="8,12,4,0"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource Primary}" VerticalAlignment="Center"/><TextBlock Text="{Binding Status}" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Text="{Binding LastSyncLabel}" Style="{StaticResource Muted}" Margin="14,3,0,0"/></StackPanel></Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="26,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Breadcrumb}" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,1,0,0"/><TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Command="{Binding OpenCommandPaletteCommand}" Margin="0,0,8,0" Padding="10,7" ToolTip="Search everything (Ctrl+K)"><StackPanel Orientation="Horizontal"><TextBlock Text="Search"/><TextBlock Text="  Ctrl K" Foreground="{DynamicResource TextMuted}"/></StackPanel></Button><ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}" Width="116" Margin="0,0,8,0" Visibility="{Binding IsSourceFilterVisible,Converter={StaticResource BoolVis}}"/><StackPanel Orientation="Horizontal" Visibility="{Binding IsGlobalRangeVisible,Converter={StaticResource BoolVis}}"><ComboBox ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}" Width="126"/><StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomRange,Converter={StaticResource BoolVis}}"><DatePicker SelectedDate="{Binding CustomStart}" Width="122" Margin="8,0,0,0"/><TextBlock Text="–" Margin="7,0" VerticalAlignment="Center"/><DatePicker SelectedDate="{Binding CustomEnd}" Width="122"/></StackPanel></StackPanel><Button Command="{Binding RefreshCommand}" Width="36" Padding="9" Margin="8,0,0,0" ToolTip="Refresh"><Viewbox><Path Data="M16,6 A7,7 0 1 0 17,12 M16,2 V7 H11" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.7" Fill="Transparent"/></Viewbox></Button><ProgressBar Width="44" Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource BoolVis}}" Margin="8,0,0,0"/></StackPanel></Grid></Border>
      <Border Grid.Row="1" Background="{DynamicResource ErrorSurface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="0,0,0,1" Padding="14,9" Visibility="{Binding HasError,Converter={StaticResource BoolVis}}"><DockPanel><Button Content="Retry" Command="{Binding RefreshCommand}" DockPanel.Dock="Right"/><TextBlock Text="{Binding Error}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
      <Border Grid.Row="2" Background="{DynamicResource SurfaceSubtle}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="22,8" Visibility="{Binding Manual.HasActiveSession,Converter={StaticResource BoolVis}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="{DynamicResource Primary}" VerticalAlignment="Center" Margin="0,0,10,0"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Manual.ActiveBookTitle}" FontWeight="SemiBold"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding Manual.ActiveSessionState}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="  ·  "/><TextBlock Text="{Binding Manual.ElapsedLabel}" FontWeight="SemiBold"/></StackPanel><Button Grid.Column="2" Content="Open timer" Command="{Binding NavigateCommand}" CommandParameter="Manual log" Margin="8,0,0,0" Padding="10,5"/><Button Grid.Column="3" Content="{Binding Manual.PauseResumeLabel}" Command="{Binding Manual.PauseResumeCommand}" Margin="8,0,0,0" Padding="10,5"/><Button Grid.Column="4" Content="Finish" Command="{Binding Manual.BeginFinishCommand}" Margin="8,0,0,0" Padding="10,5"/></Grid></Border>
      <Grid Grid.Row="3"><views:OverviewView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Today}"/><views:ActivityView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Activity}"/><views:SessionsView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Sessions}"/><views:ManualLogView DataContext="{Binding Manual}" Visibility="{Binding DataContext.SelectedPage,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource PageVis},ConverterParameter=Manual log}"/><views:BooksView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Books}"/><views:NotesView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Notes}"/><views:GoalsView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Goals}"/><views:StatisticsView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Statistics}"/><views:YearView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Year in Reading}"/><views:SettingsView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Settings}"/></Grid>
    </Grid>
    <Grid Grid.ColumnSpan="2" Panel.ZIndex="100" Background="#99000000" Visibility="{Binding IsCommandPaletteOpen,Converter={StaticResource BoolVis}}" MouseDown="CommandPaletteBackdrop_MouseDown">
      <Border Width="680" MaxHeight="560" Margin="0,84,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="10" MouseDown="CommandPalettePanel_MouseDown"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="CommandSearchBox" Text="{Binding GlobalSearch,UpdateSourceTrigger=PropertyChanged}" FontSize="18" Padding="18,15" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border}" ToolTip="Search pages, books, notes, and sessions" IsVisibleChanged="CommandSearchBox_IsVisibleChanged" KeyDown="CommandSearchBox_KeyDown"/><ListBox Grid.Row="1" ItemsSource="{Binding GlobalSearchResults}" SelectedItem="{Binding SelectedGlobalSearchResult}" Background="Transparent" BorderThickness="0" Padding="8" MaxHeight="430"><ListBox.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.OpenGlobalSearchResultCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Kind}" Style="{StaticResource Eyebrow}" VerticalAlignment="Top" Margin="0,3,8,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></Grid></Button></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,10"><TextBlock Text="Enter to open  ·  Esc to close  ·  Search pages, books, notes and sessions" Style="{StaticResource Muted}"/></Border></Grid></Border>
    </Grid>
  </Grid>
</Window>
