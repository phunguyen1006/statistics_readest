      <ContentControl x:Name="PageHost" Grid.Row="3" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
    <Grid Grid.ColumnSpan="2" Panel.ZIndex="100" Background="#99000000" Visibility="{Binding IsCommandPaletteOpen,Converter={StaticResource BoolVis}}" MouseDown="CommandPaletteBackdrop_MouseDown">
      <Border Width="680" MaxHeight="560" Margin="0,84,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="10" MouseDown="CommandPalettePanel_MouseDown"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="CommandSearchBox" Text="{Binding GlobalSearch,UpdateSourceTrigger=PropertyChanged}" FontSize="18" Padding="18,15" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border}" ToolTip="{loc:Loc Key=s18EA28C199699F19}" IsVisibleChanged="CommandSearchBox_IsVisibleChanged" KeyDown="CommandSearchBox_KeyDown"/><ListBox Grid.Row="1" ItemsSource="{Binding GlobalSearchResults}" SelectedItem="{Binding SelectedGlobalSearchResult}" Background="Transparent" BorderThickness="0" Padding="8" MaxHeight="430"><ListBox.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.OpenGlobalSearchResultCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Kind}" Style="{StaticResource Eyebrow}" VerticalAlignment="Top" Margin="0,3,8,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail,Converter={StaticResource UiText}}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></Grid></Button></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,10"><TextBlock Text="{loc:Loc Key=s584BCE8A12F4AF8B}" Style="{StaticResource Muted}"/></Border></Grid></Border>
    </Grid>
