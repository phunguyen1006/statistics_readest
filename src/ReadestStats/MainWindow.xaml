<Window x:Class="ReadestStats.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:charts="clr-namespace:ReadestStats.Controls" Title="Readest Stats" Width="1240" Height="820" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/><local:DurationConverter xmlns:local="clr-namespace:ReadestStats" x:Key="Duration"/><local:FileSizeConverter xmlns:local="clr-namespace:ReadestStats" x:Key="FileSize"/><local:PercentChangeConverter xmlns:local="clr-namespace:ReadestStats" x:Key="PercentChange"/>
        <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Style>
        <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="6,18,6,8"/></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Primary}" Margin="0,0,12,0"><TextBlock Text="R" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Readest Stats" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><ProgressBar Width="90" Height="5" IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource BoolVis}}"/><Button Content="Refresh" Command="{Binding RefreshCommand}" ToolTip="Read the latest events from Readest"/></StackPanel>
            </Grid>
        </Border>
        <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="0,0,0,1" Padding="14" DockPanel.Dock="Top" Visibility="{Binding HasError,Converter={StaticResource BoolVis}}"><DockPanel><Button DockPanel.Dock="Right" Content="Choose statistics.db" Command="{Binding ChangeDatabaseCommand}"/><TextBlock Text="{Binding Error}" Foreground="#9A3412" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
        <TabControl Background="{DynamicResource AppBackground}" BorderThickness="0" TabStripPlacement="Left">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16" MaxWidth="1180">
                    <Border Style="{StaticResource Card}" Visibility="{Binding NoData,Converter={StaticResource BoolVis}}"><StackPanel HorizontalAlignment="Center" Margin="20"><TextBlock Text="No reading activity yet" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Read a book in Readest and your statistics will appear here automatically." Style="{StaticResource Muted}" Margin="0,8"/></StackPanel></Border>
                    <DockPanel><ComboBox DockPanel.Dock="Right" SelectedValuePath="Content" SelectedValue="{Binding Range}" Width="130"><ComboBoxItem Content="7 days"/><ComboBoxItem Content="30 days" IsSelected="True"/><ComboBoxItem Content="90 days"/><ComboBoxItem Content="1 year"/><ComboBoxItem Content="All time"/></ComboBox><TextBlock Text="Overview" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                    <UniformGrid Columns="6">
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Total Reading" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Overview.TotalSeconds,Converter={StaticResource Duration}}" Style="{StaticResource MetricValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Reading Today" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Overview.TodaySeconds,Converter={StaticResource Duration}}" Style="{StaticResource MetricValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Current Streak" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Overview.CurrentStreak,StringFormat={}{0} days}" Style="{StaticResource MetricValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Longest Streak" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Overview.LongestStreak,StringFormat={}{0} days}" Style="{StaticResource MetricValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Active Days" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Overview.ActiveDays}" Style="{StaticResource MetricValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Books Read" Style="{StaticResource Muted}" ToolTip="Books with at least one reading event"/><TextBlock Text="{Binding Overview.BooksRead}" Style="{StaticResource MetricValue}"/></StackPanel></Border>
                    </UniformGrid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Reading trend" FontSize="18" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding Overview.Comparison.PercentChange,Converter={StaticResource PercentChange}}" Foreground="{DynamicResource Success}"/></DockPanel><charts:BarChart ItemsSource="{Binding Trend}" Height="220" Margin="0,14,0,0"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Insights" FontSize="18" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding Insights}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceAlt}" CornerRadius="7" Padding="10" Margin="0,7,0,0"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    </Grid>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="365-day reading activity" FontSize="18" FontWeight="SemiBold"/><charts:HeatmapChart ItemsSource="{Binding Heatmap}" Height="115" Margin="0,12,0,0"/></StackPanel></Border>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Time of day" FontSize="18" FontWeight="SemiBold"/><charts:BarChart ItemsSource="{Binding Hourly}" Height="185"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Day of week" FontSize="18" FontWeight="SemiBold"/><ComboBox DockPanel.Dock="Right" SelectedValuePath="Content" SelectedValue="{Binding WeekdayMode}" Width="170"><ComboBoxItem Content="Total time"/><ComboBoxItem Content="Average per occurrence"/></ComboBox></DockPanel><charts:BarChart ItemsSource="{Binding WeekdaysDisplay}" Height="185"/></StackPanel></Border></Grid>
                    <TextBlock Text="Personal Records" Style="{StaticResource Section}"/><ItemsControl ItemsSource="{Binding Records}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="245"><StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Value}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Activity">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><TextBlock Text="Activity" FontSize="27" FontWeight="SemiBold"/><Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button Content="‹ Previous month" Command="{Binding PreviousMonthCommand}"/><Button DockPanel.Dock="Right" Content="Next month ›" Command="{Binding NextMonthCommand}"/><TextBlock Text="{Binding MonthLabel}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding MonthlySummary}" Margin="4,10" TextWrapping="Wrap"/><TextBlock Text="Daily reading minutes" Style="{StaticResource Muted}" Margin="4"/><charts:BarChart ItemsSource="{Binding Monthly}" Height="250"/><TextBlock Text="Calendar heatmap" Style="{StaticResource Muted}" Margin="4,12,4,0"/><charts:HeatmapChart ItemsSource="{Binding MonthlyHeatmap}" Height="115"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button Content="‹ Previous year" Command="{Binding PreviousYearCommand}"/><Button DockPanel.Dock="Right" Content="Next year ›" Command="{Binding NextYearCommand}"/><TextBlock Text="{Binding Year}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding YearlySummary}" Margin="4,10" TextWrapping="Wrap"/><TextBlock Text="Monthly reading hours" Style="{StaticResource Muted}" Margin="4"/><charts:BarChart ItemsSource="{Binding Yearly}" Height="260"/><TextBlock Text="Year heatmap" Style="{StaticResource Muted}" Margin="4,12,4,0"/><charts:HeatmapChart ItemsSource="{Binding YearlyHeatmap}" Height="115"/></StackPanel></Border></StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Sessions">
                <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Sessions" FontSize="27" FontWeight="SemiBold"/><UniformGrid Columns="5"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Total" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SessionSummary.Total}" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Average" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SessionSummary.AverageSeconds,Converter={StaticResource Duration}}" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Median" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SessionSummary.MedianSeconds,Converter={StaticResource Duration}}" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Longest" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SessionSummary.LongestSeconds,Converter={StaticResource Duration}}" Style="{StaticResource MetricValue}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="This week" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SessionSummary.ThisWeek}" Style="{StaticResource MetricValue}"/></StackPanel></Border></UniformGrid></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" Margin="6" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"><DataGrid.Columns><DataGridTextColumn Header="Start" Binding="{Binding Start,StringFormat={}{0:MMM d · HH:mm}}" Width="170"/><DataGridTextColumn Header="End" Binding="{Binding End,StringFormat={}{0:HH:mm}}" Width="100"/><DataGridTextColumn Header="Duration" Binding="{Binding DurationSeconds,Converter={StaticResource Duration}}" Width="120"/><DataGridTextColumn Header="Books" Binding="{Binding Books}" Width="*"/><DataGridTextColumn Header="Page events" Binding="{Binding EventCount}" Width="120"/></DataGrid.Columns></DataGrid><Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Selected session" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedSession.Start,StringFormat={}{0:MMM d, yyyy · HH:mm}}"/><TextBlock Text="{Binding SelectedSession.DurationSeconds,Converter={StaticResource Duration}}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedSession.Books}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedSession.EventCount,StringFormat={}{0} page events}" Style="{StaticResource Muted}"/><charts:BarChart ItemsSource="{Binding SessionTimeline}" Height="100"/></StackPanel></Border></Grid>
            </TabItem>
            <TabItem Header="Books">
                <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Books with activity" FontSize="27" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Text="{Binding BookSearch,UpdateSourceTrigger=PropertyChanged}" Width="190" ToolTip="Search title or author"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding BookSort}" Width="185"><ComboBoxItem Content="Most read"/><ComboBoxItem Content="Recently read"/><ComboBoxItem Content="Title"/><ComboBoxItem Content="Reading time ascending"/></ComboBox></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" Margin="6" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"><DataGrid.Columns><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Author" Binding="{Binding Authors}" Width="160"/><DataGridTextColumn Header="Reading time" Binding="{Binding Seconds,Converter={StaticResource Duration}}" Width="120"/><DataGridTextColumn Header="Active days" Binding="{Binding ActiveDays}" Width="95"/><DataGridTextColumn Header="Page events" Binding="{Binding EventCount}" Width="95"/></DataGrid.Columns></DataGrid><Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="14,6,6,6"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding BookDetail.Summary.Title}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding BookDetail.Summary.Authors}" Style="{StaticResource Muted}"/><Separator Margin="0,14"/><TextBlock Text="Total reading" Style="{StaticResource Muted}"/><TextBlock Text="{Binding BookDetail.Summary.Seconds,Converter={StaticResource Duration}}" Style="{StaticResource MetricValue}"/><TextBlock Text="{Binding BookDetail.Summary.ActiveDays,StringFormat={}{0} active days}" Margin="0,10,0,0"/><TextBlock Text="{Binding BookDetail.CurrentStreak,StringFormat=Current book streak: {0} days}"/><TextBlock Text="{Binding BookDetail.LongestStreak,StringFormat=Longest book streak: {0} days}"/><TextBlock Text="{Binding BookDetail.Sessions,StringFormat=Sessions: {0}}"/><TextBlock Text="{Binding BookDetail.AverageSessionSeconds,Converter={StaticResource Duration},StringFormat=Average session: {0}}"/><TextBlock Text="{Binding BookDetail.LongestSessionSeconds,Converter={StaticResource Duration},StringFormat=Longest session: {0}}"/><TextBlock Text="{Binding BookDetail.MedianEventSeconds,Converter={StaticResource Duration},StringFormat=Median time per page event: {0}}"/><TextBlock Text="Page-based metrics may vary when pagination or reader layout changes." Style="{StaticResource Muted}" Margin="0,12"/><TextBlock Text="Daily reading" FontSize="17" FontWeight="SemiBold"/><charts:BarChart ItemsSource="{Binding BookTrend}" Height="170"/><TextBlock Text="365-day activity" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0"/><charts:HeatmapChart ItemsSource="{Binding BookHeatmap}" Height="115"/><TextBlock Text="Time of day" FontSize="17" FontWeight="SemiBold"/><charts:BarChart ItemsSource="{Binding BookHourly}" Height="150"/><TextBlock Text="Day of week" FontSize="17" FontWeight="SemiBold"/><charts:BarChart ItemsSource="{Binding BookWeekdays}" Height="150"/><TextBlock Text="Session history" FontSize="17" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding BookSessions}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,4"><Run Text="{Binding Start,StringFormat={}{0:MMM d · HH:mm}}"/><Run Text=" — "/><Run Text="{Binding DurationSeconds,Converter={StaticResource Duration}}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Border></Grid>
            </TabItem>
            <TabItem Header="Goals">
                <ScrollViewer><StackPanel Margin="18" MaxWidth="760"><TextBlock Text="Goals" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Goals are stored only in Readest Stats, never in Readest's database." Style="{StaticResource Muted}" Margin="0,4,0,12"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Daily minutes" FontSize="17" FontWeight="SemiBold"/><TextBox Text="{Binding DailyGoalMinutes}"/><ProgressBar Value="{Binding DailyGoalProgress,Mode=OneWay}" Height="14" Maximum="100"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Weekly minutes" FontSize="17" FontWeight="SemiBold"/><TextBox Text="{Binding WeeklyGoalMinutes}"/><ProgressBar Value="{Binding WeeklyGoalProgress,Mode=OneWay}" Height="14" Maximum="100"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Monthly hours" FontSize="17" FontWeight="SemiBold"/><TextBox Text="{Binding MonthlyGoalHours}"/><ProgressBar Value="{Binding MonthlyGoalProgress,Mode=OneWay}" Height="14" Maximum="100"/></StackPanel></Border><Button Content="Save goals" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Background="{DynamicResource Primary}" Foreground="White"/></StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Settings">
                <ScrollViewer><StackPanel Margin="18" MaxWidth="820"><TextBlock Text="Settings" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Data source" Style="{StaticResource Section}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Database path" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Diagnostics.Path}" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,4,0,10"/><WrapPanel><Button Content="Change database" Command="{Binding ChangeDatabaseCommand}"/><Button Content="Re-detect" Command="{Binding RedetectCommand}"/><Button Content="Open folder" Command="{Binding OpenFolderCommand}"/><Button Content="Reconnect" Command="{Binding RefreshCommand}"/></WrapPanel><Separator Margin="0,12"/><UniformGrid Columns="3"><StackPanel><TextBlock Text="Books" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Diagnostics.Books}" FontSize="18"/></StackPanel><StackPanel><TextBlock Text="Page events" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Diagnostics.Events}" FontSize="18"/></StackPanel><StackPanel><TextBlock Text="Database size" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Diagnostics.SizeBytes,Converter={StaticResource FileSize}}" FontSize="18"/></StackPanel><StackPanel><TextBlock Text="First event" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Diagnostics.FirstEvent,StringFormat={}{0:g}}"/></StackPanel><StackPanel><TextBlock Text="Latest event" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Diagnostics.LatestEvent,StringFormat={}{0:g}}"/></StackPanel><StackPanel><TextBlock Text="Schema version" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Diagnostics.SchemaVersion}"/></StackPanel></UniformGrid></StackPanel></Border><TextBlock Text="Statistics" Style="{StaticResource Section}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Session gap threshold"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding SessionGapMinutes}"><ComboBoxItem Content="2"/><ComboBoxItem Content="5"/><ComboBoxItem Content="10"/><ComboBoxItem Content="15"/></ComboBox><TextBlock Text="First day of week" Margin="4,12,4,0"/><ComboBox SelectedValuePath="Content" SelectedValue="{Binding FirstDayOfWeek}"><ComboBoxItem Content="Monday"/><ComboBoxItem Content="Sunday"/></ComboBox><TextBlock Text="Choose the default range on the Overview page, then click Save settings." Style="{StaticResource Muted}" Margin="4"/></StackPanel></Border><TextBlock Text="Appearance &amp; refresh" Style="{StaticResource Section}"/><Border Style="{StaticResource Card}"><StackPanel><ComboBox SelectedValuePath="Content" SelectedValue="{Binding Theme}"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox><CheckBox Content="Auto refresh when Readest data changes" IsChecked="{Binding AutoRefresh}" Padding="4"/></StackPanel></Border><Button Content="Save settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Background="{DynamicResource Primary}" Foreground="White"/><TextBlock Text="Export" Style="{StaticResource Section}"/><WrapPanel><Button Content="Export daily CSV" Command="{Binding ExportCsvCommand}"/><Button Content="Export summary JSON" Command="{Binding ExportJsonCommand}"/></WrapPanel><TextBlock Text="About" Style="{StaticResource Section}"/><TextBlock Text="Readest Stats is an independent local statistics viewer for Readest reading data. It opens the source database read-only and stores its own settings separately." Style="{StaticResource Muted}"/></StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
