<Window x:Class="ReadestStats.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ReadestStats.Views" xmlns:local="clr-namespace:ReadestStats" Title="Readest Stats" Icon="Assets/readest-book.ico" Width="1180" Height="760" MinWidth="1100" MinHeight="650" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.InputBindings>
    <KeyBinding Gesture="Ctrl+R" Command="{Binding RefreshCommand}"/>
    <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateCommand}" CommandParameter="Overview"/><KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateCommand}" CommandParameter="Activity"/>
    <KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateCommand}" CommandParameter="Sessions"/><KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateCommand}" CommandParameter="Books"/>
    <KeyBinding Gesture="Ctrl+5" Command="{Binding NavigateCommand}" CommandParameter="Goals"/><KeyBinding Gesture="Ctrl+6" Command="{Binding NavigateCommand}" CommandParameter="Insights"/>
    <KeyBinding Gesture="Ctrl+7" Command="{Binding NavigateCommand}" CommandParameter="Year in Reading"/><KeyBinding Gesture="Ctrl+8" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
  </Window.InputBindings>
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVis"/><local:InverseBooleanVisibilityConverter x:Key="InverseBoolVis"/><local:PageVisibilityConverter x:Key="PageVis"/><local:DurationConverter x:Key="Duration"/><local:FileSizeConverter x:Key="FileSize"/><local:PercentChangeConverter x:Key="PercentChange"/><local:BoolOpacityConverter x:Key="BoolOpacity"/><local:IntensityBrushConverter x:Key="IntensityBrush"/></Window.Resources>
  <Grid Background="{DynamicResource AppBackground}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="12,16">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="8,0,0,20"><Image Source="Assets/readest-book.png" Width="30" Height="30" Stretch="Uniform" AutomationProperties.Name="Readest Stats book icon"/><TextBlock Text="Readest Stats" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/></StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Navigation}" SelectedValuePath="Name" SelectedValue="{Binding SelectedPage}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItemStyle}" KeyboardNavigation.TabNavigation="Cycle">
          <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Data="{Binding Icon}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="8,12,4,0"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource Primary}" VerticalAlignment="Center"/><TextBlock Text="{Binding Status}" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Text="{Binding LastSyncLabel}" Style="{StaticResource Muted}" Margin="14,3,0,0"/></StackPanel></Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="26,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Command="{Binding BackCommand}" Width="36" Height="36" Padding="9" Margin="0,0,12,0" ToolTip="Back to previous page" AutomationProperties.Name="Back to previous page"><Viewbox><Path Data="M14,3 L7,10 L14,17 M7,10 H18" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.7" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox></Button><StackPanel><TextBlock Text="{Binding Breadcrumb}" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SelectedPage}" FontSize="20" FontWeight="SemiBold" Margin="0,1,0,0"/><TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}" Width="126" AutomationProperties.Name="Global date range"/><StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomRange,Converter={StaticResource BoolVis}}"><DatePicker SelectedDate="{Binding CustomStart}" Width="122" Margin="8,0,0,0"/><TextBlock Text="–" Margin="7,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/><DatePicker SelectedDate="{Binding CustomEnd}" Width="122"/></StackPanel><Button Command="{Binding RefreshCommand}" Width="36" Padding="9" Margin="8,0,0,0" ToolTip="Refresh Readest statistics" AutomationProperties.Name="Refresh Readest statistics"><Viewbox><Path Data="M16,6 A7,7 0 1 0 17,12 M16,2 V7 H11" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.7" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox></Button><ProgressBar Width="44" Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource BoolVis}}" Margin="8,0,0,0"/></StackPanel></Grid></Border>
      <Border Grid.Row="1" Background="{DynamicResource ErrorSurface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="0,0,0,1" Padding="14,9" Visibility="{Binding HasError,Converter={StaticResource BoolVis}}"><DockPanel><Button Content="Retry" Command="{Binding RefreshCommand}" DockPanel.Dock="Right"/><TextBlock Text="{Binding Error}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
      <Grid Grid.Row="2"><views:OverviewView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Overview}"/><views:ActivityView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Activity}"/><views:SessionsView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Sessions}"/><views:BooksView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Books}"/><views:GoalsView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Goals}"/><views:InsightsView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Insights}"/><views:YearView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Year in Reading}"/><views:SettingsView Visibility="{Binding SelectedPage,Converter={StaticResource PageVis},ConverterParameter=Settings}"/></Grid>
    </Grid>
  </Grid>
</Window>
