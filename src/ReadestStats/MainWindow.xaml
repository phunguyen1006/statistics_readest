<Window x:Class="ReadestStats.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:ReadestStats.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ReadestStats.Views" xmlns:local="clr-namespace:ReadestStats" Title="Readest Stats" Icon="Assets/readest-book.ico" Width="1180" Height="760" MinWidth="1100" MinHeight="650" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
